msgstr "Es un mamparo pa una casa."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.INTERIOR_WALL_UPHOLSTERED
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.INTERIOR_WALL_UPHOLSTERED"
