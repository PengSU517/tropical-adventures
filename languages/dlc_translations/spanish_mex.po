msgstr "¡No nos hagas caca encima!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CITY_HAMMER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CITY_HAMMER"
