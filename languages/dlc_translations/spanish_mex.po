msgstr "¡Genial!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CLAWPALMTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CLAWPALMTREE_SAPLING"
