msgstr "No es muy cómoda."

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.RUG_NAILBED
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.RUG_NAILBED"
