msgstr "Totalmente inútil."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PORKLAND_INTRO_SANDBAG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PORKLAND_INTRO_SANDBAG"
