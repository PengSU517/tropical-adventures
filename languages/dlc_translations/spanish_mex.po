msgstr "Serás una deliciosa comida."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DRAGONFRUIT_SEEDS"
