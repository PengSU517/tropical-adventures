msgstr "Encantadora."

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.RUG_HOOFPRINT
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.RUG_HOOFPRINT"
