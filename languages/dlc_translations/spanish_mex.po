msgstr "Un animal que mantiene mis pies calientes."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUG_HOOFPRINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUG_HOOFPRINT"
