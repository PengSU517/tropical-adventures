msgstr "Un pequeño lagarto extraño."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PORKLAND_INTRO_BALLOON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PORKLAND_INTRO_BALLOON"
