msgstr "Necesitas un hogar en la tierra."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DRAGONPIE"
