msgstr "Biselado."

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.INTERIOR_WALL_HARLEQUIN
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.INTERIOR_WALL_HARLEQUIN"
