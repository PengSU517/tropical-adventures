msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CUTLICHEN"
msgid "I picked it. But I won't eat it."
msgstr "Lo tengo. Pero no me lo comeré."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CUTNETTLE
