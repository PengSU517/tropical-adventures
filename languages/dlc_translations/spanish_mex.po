#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INTERIOR_FLOOR_SHAG_CARPET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INTERIOR_FLOOR_SHAG_CARPET"
