msgstr "Poco sofisticada."

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.RUG_BRAID
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.RUG_BRAID"
