msgstr "Dejó de funcionar."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTMAN.GENERIC"
