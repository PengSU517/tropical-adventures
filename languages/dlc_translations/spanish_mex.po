msgstr "¡Mis tesoros!"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DUG_BAMBOOTREE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DUG_BAMBOOTREE"
