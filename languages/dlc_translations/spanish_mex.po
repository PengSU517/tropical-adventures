msgstr "Pequeñín viscoso."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SLUGBUG_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SLUGBUG_COOKED"
