msgstr "No puedo evitar admirar las formaciones naturales."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_FLIPPABLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_FLIPPABLE"
