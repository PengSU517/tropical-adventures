msgstr "El suelo es aburrido."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TURF_DEEPRAINFOREST_NOCANOPY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TURF_DEEPRAINFOREST_NOCANOPY"
