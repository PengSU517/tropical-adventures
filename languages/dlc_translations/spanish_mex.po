msgstr "Esto es obra de un chiflado."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DOYDOY
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DOYDOY"
