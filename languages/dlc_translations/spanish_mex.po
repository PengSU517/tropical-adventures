msgstr "Todo está en ruinas."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RUIN_GIANT_HEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RUIN_GIANT_HEAD"
