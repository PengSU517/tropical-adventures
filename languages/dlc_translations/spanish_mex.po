msgstr "Esta alfombra es muy suave."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUG_SWIRL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUG_SWIRL"
