msgstr "No hay nadie en casa."

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.WALRUS_CAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.WALRUS_CAMP.GENERIC"
