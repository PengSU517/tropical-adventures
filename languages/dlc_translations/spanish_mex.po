msgstr "Poco refinada."

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.RUG_HEDGEHOG
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.RUG_HEDGEHOG"
