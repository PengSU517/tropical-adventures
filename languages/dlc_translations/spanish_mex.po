msgstr "La prefiero muerta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.JELLYFISH_PLANTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.JELLYFISH_PLANTED"
