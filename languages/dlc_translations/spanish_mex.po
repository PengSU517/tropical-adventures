msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCORPION.GENERIC"
msgid "That better not be poisonous."
msgstr "Espero que no sea venenoso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCORPION.SLEEPING
