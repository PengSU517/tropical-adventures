msgstr "Creo que esto servirá."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHELVES_BASIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHELVES_BASIC"
