msgstr "Qué pájaro tan estúpido."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DOYDOYBABY
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DOYDOYBABY"
