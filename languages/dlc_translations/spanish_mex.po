msgstr "Son unas criaturitas bastante nerviosas, ¿no?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.JELLYBUG_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.JELLYBUG_COOKED"
