msgstr "¡Sigue esas burbujas!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_WHALE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_WHALE_HUNT_LOST_TRAIL"
