msgstr "Un buen ejemplar animal."

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.RUG_RECTANGLE
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.RUG_RECTANGLE"
