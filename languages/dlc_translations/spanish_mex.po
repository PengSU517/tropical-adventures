msgstr "Este tesoro es un pastel."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DRAGON_SCALES"
