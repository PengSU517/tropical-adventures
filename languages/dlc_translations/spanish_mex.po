msgstr "¡Competencia de miradas! Un, dos, tres, ¡VAMOS!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUG_RUBBERMAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUG_RUBBERMAT"
