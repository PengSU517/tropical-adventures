msgstr "¡Brilla!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BRAINJELLYHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BRAINJELLYHAT"
