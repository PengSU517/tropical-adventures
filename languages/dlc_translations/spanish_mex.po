#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INTERIOR_FLOOR_PLAID_TILE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INTERIOR_FLOOR_PLAID_TILE"
