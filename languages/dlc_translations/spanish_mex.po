msgstr "La descendencia de un humanoide Formicidae agresivo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTMASKHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTMASKHAT"
