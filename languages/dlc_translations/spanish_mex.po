msgstr "Verdusco."

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.INTERIOR_WALL_FULLWALL_MOULDING
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.INTERIOR_WALL_FULLWALL_MOULDING"
