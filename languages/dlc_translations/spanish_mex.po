msgstr "Burocrático."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INTERIOR_WALL_PEAGAWK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INTERIOR_WALL_PEAGAWK"
