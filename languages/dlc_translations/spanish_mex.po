msgstr "Esta alfombra es muy suave."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUG_TILES
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUG_TILES"
