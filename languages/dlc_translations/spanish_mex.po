msgstr "Un mueble bastante sólido."

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SHELVES_MIDCENTURY
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SHELVES_MIDCENTURY"
