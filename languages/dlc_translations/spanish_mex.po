msgstr "Habrá que repararlo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INTERIOR_FLOOR_WOOD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INTERIOR_FLOOR_WOOD"
