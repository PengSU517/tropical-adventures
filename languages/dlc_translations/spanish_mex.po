msgstr "Esto me lo llevo yo."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DUG_COFFEEBUSH
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DUG_COFFEEBUSH"
