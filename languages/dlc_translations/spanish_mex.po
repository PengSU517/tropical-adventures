msgstr "Disfruto del lindo canto de un ave."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTMAN.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTMAN.DEAD"
