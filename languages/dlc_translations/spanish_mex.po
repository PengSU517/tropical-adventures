msgstr "Está trabajando duro para hacerme hielo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEMAKER.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEMAKER.LOW"
