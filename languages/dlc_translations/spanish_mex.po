msgstr "Buen alojamiento."

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.WALRUS_TUSK
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.WALRUS_TUSK"
