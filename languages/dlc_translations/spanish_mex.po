#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INTERIOR_FLOOR_HOOF_CURVY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INTERIOR_FLOOR_HOOF_CURVY"
