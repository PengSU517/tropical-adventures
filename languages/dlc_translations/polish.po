msgstr "Podnóżkowate."

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_CHAIR_HORNED
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_CHAIR_HORNED"
