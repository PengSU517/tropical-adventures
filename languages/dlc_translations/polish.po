msgstr "Fragmentaryczne."

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.INTERIOR_FLOOR_WOOD
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.INTERIOR_FLOOR_WOOD"
