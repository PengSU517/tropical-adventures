msgstr "Industrialne."

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.INTERIOR_FLOOR_TRANSITIONAL
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.INTERIOR_FLOOR_TRANSITIONAL"
