msgstr "Przyjemnie chłodny."

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.HEATROCK.FROZEN"
