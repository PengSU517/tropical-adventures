msgstr "Nie najgorszy."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.CAVE_BANANA_TREE"
