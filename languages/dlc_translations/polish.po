msgstr "Nieźle!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_CITYHALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_CITYHALL.GENERIC"
