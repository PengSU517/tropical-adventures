msgstr "Dla osoby eleganckiej, ale oczytanej."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SWEETPOTATOSOUFFLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SWEETPOTATOSOUFFLE"
