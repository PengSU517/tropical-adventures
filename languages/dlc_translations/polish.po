msgstr "Dobre drzewo, co nie?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HEDGE_CONE_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HEDGE_CONE_ITEM"
