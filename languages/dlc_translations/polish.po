msgstr "Śpi. Nic dziwnego."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGMAN_USHER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGMAN_USHER.GENERIC"
