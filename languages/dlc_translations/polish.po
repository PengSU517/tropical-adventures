msgstr "Patyk."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROC_NEST_DEBRIS2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROC_NEST_DEBRIS2"
