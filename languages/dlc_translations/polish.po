msgstr "Chyba chce pogadać."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SUNKEN_BOAT_BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SUNKEN_BOAT_BURNT"
