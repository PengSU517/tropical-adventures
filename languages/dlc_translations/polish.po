msgstr "Niegrzecznie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_RUINS_ENTRANCE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_RUINS_ENTRANCE.GENERIC"
