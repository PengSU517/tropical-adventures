msgstr "Jedzenie!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_FLORIST.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_FLORIST.BURNING"
