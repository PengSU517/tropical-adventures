msgstr "Ale będziemy mieć frajdę na tym siodle!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SAIL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SAIL"
