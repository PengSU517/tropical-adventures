msgstr "Pełno tu grubych ryb."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_CITYHALL.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_CITYHALL.BURNING"
