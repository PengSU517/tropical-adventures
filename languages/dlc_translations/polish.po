msgstr "To chyba koniec."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_RUINS_EXIT2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_RUINS_EXIT2"
