msgstr "Uwielbiam takie widoki!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_HATSHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_HATSHOP.GENERIC"
