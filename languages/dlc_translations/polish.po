#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SWINGING_LIGHT_BASIC_BULB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SWINGING_LIGHT_BASIC_BULB"
