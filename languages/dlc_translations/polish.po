msgstr "Kolczaste."

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_CHAIR_LOUNGE
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_CHAIR_LOUNGE"
