msgstr "Duży, kruchy kamyk."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_FLIPPABLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_FLIPPABLE"
