msgstr "Tutaj pracuje apodyktyczny gnojek."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_CITYHALL_PLAYER.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_CITYHALL_PLAYER.BURNING"
