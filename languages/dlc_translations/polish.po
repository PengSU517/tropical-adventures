#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_SHOP_CITYHALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_SHOP_CITYHALL.GENERIC"
