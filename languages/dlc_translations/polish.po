msgstr "Palenie przyspiesza śmierć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECO_WALLORNAMENT_PERIODIC_TABLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECO_WALLORNAMENT_PERIODIC_TABLE"
