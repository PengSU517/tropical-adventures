msgstr "Czy może rozłupać moje serce na pół?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECO_WALLORNAMENT_BLACK_CAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECO_WALLORNAMENT_BLACK_CAT"
