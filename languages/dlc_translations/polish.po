msgstr "Wymyślne."

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_LAMP_2FRINGES
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_LAMP_2FRINGES"
