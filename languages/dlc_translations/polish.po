msgstr "Jest za jasno."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NODAYSLEEP_CAVE"
