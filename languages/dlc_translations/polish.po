msgstr "Pajęczak o twardym karapaksie."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SPIDER_MONKEY.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SPIDER_MONKEY.DEAD"
