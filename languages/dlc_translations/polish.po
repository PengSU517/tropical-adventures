msgstr "Naturalne środowisko krwiożerczego ssaka."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.VAMPIRE_BAT_WING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.VAMPIRE_BAT_WING"
