msgstr "Woodlegs musi uważać."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.ELEPHANTCACTUS_ACTIVE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.ELEPHANTCACTUS_ACTIVE"
