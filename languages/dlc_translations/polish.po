msgstr "Bezwartościowa wiedza."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECO_WALLORNAMENT_PHOTO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECO_WALLORNAMENT_PHOTO"
