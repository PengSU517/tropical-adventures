msgstr "Powinnam ją zapalić!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_RUINS_TORCH_WALL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_RUINS_TORCH_WALL"
