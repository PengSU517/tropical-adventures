msgstr "Nie mój rozmiar."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SUNKEN_RELIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SUNKEN_RELIC"
