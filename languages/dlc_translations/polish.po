msgstr "Do czegoś mi się przyda."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEPORTATO_HAMLET_POTATO
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEPORTATO_HAMLET_POTATO"
