msgstr "Płoń. Płoń. Płoń!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_FLORIST.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_FLORIST.GENERIC"
