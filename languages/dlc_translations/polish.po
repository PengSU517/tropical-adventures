msgstr "Nonsensowna, dramatyczna szata."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECO_WALLORNAMENT_EMBROIDERY_HOOP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECO_WALLORNAMENT_EMBROIDERY_HOOP"
