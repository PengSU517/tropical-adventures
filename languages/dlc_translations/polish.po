msgstr "Toż to jeden z jotunów!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HIPPO_ANTLER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HIPPO_ANTLER"
