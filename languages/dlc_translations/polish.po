msgstr "Mobilna latarnia morska."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_TORCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_TORCH"
