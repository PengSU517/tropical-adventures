msgstr "Szczegółowy rysunek techniczny."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERMUDATRIANGLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERMUDATRIANGLE"
