msgstr "Nasiona, po prostu."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.EARMUFFSHAT"
