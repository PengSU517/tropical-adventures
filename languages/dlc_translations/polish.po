#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DECO_WALLORNAMENT_FULLLENGTH_MIRROR
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DECO_WALLORNAMENT_FULLLENGTH_MIRROR"
