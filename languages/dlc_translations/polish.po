#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.INTERIOR_FLOOR_SHEET_METAL
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.INTERIOR_FLOOR_SHEET_METAL"
