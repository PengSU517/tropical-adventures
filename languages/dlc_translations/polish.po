msgstr "Wszystko poszło z dymem."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SNAKEDEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SNAKEDEN.CHOPPED"
