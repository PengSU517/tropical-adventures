msgstr "Zniszczyć broń ogniem!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_WEAPONS.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_WEAPONS.GENERIC"
