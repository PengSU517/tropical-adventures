msgstr "Nie ma żadnych porzeczek."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROC_NEST_DEBRIS1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROC_NEST_DEBRIS1"
