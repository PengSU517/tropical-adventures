msgstr "Pudło."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_RUINS_TORCH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_RUINS_TORCH"
