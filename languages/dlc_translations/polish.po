msgstr "Nie ma na czym stanąć."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENT_ROBOT_RIBS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENT_ROBOT_RIBS"
