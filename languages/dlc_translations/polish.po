msgstr "Kamienie. Ble."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_VOLCANO
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_VOLCANO"
