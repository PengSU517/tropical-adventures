msgstr "Ale się jara!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_SHOP_FLORIST.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_SHOP_FLORIST.GENERIC"
