msgstr "Spiczasta."

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_CHAIR_CLASSIC
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_CHAIR_CLASSIC"
