#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_SHOP_GENERAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_SHOP_GENERAL.GENERIC"
