msgstr "To chyba znaczy, że mam zapalić ogień!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_PALACE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_PALACE"
