msgstr "Do odpoczynku."

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_CHAIR_ROCKING
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_CHAIR_ROCKING"
