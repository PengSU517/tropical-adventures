msgstr "Wydłuża żywot jednostek wodnych."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_LANTERN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_LANTERN"
