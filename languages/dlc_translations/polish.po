msgstr "Tak jest. Straciliśmy go."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PORKLAND_INTRO_BASKET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PORKLAND_INTRO_BASKET"
