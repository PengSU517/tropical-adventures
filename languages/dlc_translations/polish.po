msgstr "Cokolwiek ozdobny."

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.HIPPOPOTAMOOSE
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.HIPPOPOTAMOOSE"
