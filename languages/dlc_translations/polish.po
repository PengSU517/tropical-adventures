msgstr "Żywopłocie, przygotuj się na strzyżenie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEDGE_BLOCK_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEDGE_BLOCK_ITEM"
