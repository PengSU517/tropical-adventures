#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.INTERIOR_FLOOR_OCTAGON
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.INTERIOR_FLOOR_OCTAGON"
