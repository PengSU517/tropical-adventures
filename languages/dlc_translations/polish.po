msgstr "Dobrze by było go spalić."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_LATIN_1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_LATIN_1"
