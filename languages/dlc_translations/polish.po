#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.INTERIOR_FLOOR_PLAID_TILE
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.INTERIOR_FLOOR_PLAID_TILE"
