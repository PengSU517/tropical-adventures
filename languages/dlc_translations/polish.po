#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_ANTIQUITIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_ANTIQUITIES.GENERIC"
