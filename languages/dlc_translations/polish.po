msgstr "Zwykły warzywniak."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIG_SHOP_TINKER.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIG_SHOP_TINKER.BURNING"
