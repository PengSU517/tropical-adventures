#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEPORTATO_HAMLET_RING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEPORTATO_HAMLET_RING"
