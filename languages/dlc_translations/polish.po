msgstr "Za wolno biegł."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIKO.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIKO.GENERIC"
