msgstr "Dziw nad dziwy."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.CAVE_BANANA_COOKED"
