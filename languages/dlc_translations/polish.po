msgstr "Wygięte."

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_LAMP_CANDELABRA
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_LAMP_CANDELABRA"
