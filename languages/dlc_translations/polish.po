msgstr "Nasiona, po prostu."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.ELEPHANTCACTUS
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.ELEPHANTCACTUS"
