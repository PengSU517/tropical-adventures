msgstr "Kwieciste."

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_LAMP_CRYSTALS
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_LAMP_CRYSTALS"
