msgstr "Teraz pomkniemy jak wiatr!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SAIL_STICK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SAIL_STICK"
