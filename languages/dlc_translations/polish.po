msgstr "Kto mieczem wojuje, ten od ognia ginie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIG_SHOP_WEAPONS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIG_SHOP_WEAPONS.GENERIC"
