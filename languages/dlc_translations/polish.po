msgstr "Materiały do budowy przytulnej chatki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER_HOUSE_COTTAGE_CRAFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER_HOUSE_COTTAGE_CRAFT"
