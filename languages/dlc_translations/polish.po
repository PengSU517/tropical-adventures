msgstr "Zabraliśmy wszystko."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SNAKEDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SNAKEDEN.GENERIC"
