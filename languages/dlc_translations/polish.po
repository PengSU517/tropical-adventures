msgstr "Nie opuszczaj mnie, światło!"

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.COLDFIREPIT.GENERIC"
