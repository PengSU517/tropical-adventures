msgstr "Chyba brakuje jakiegoś elementu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_SW_BOX
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_SW_BOX"
