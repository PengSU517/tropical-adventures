msgstr "Powinni go zwolnić."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGMAN_STOREOWNER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGMAN_STOREOWNER.GENERIC"
