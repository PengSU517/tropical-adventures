msgstr "Czarujące."

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_CHAIR_CORNER
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_CHAIR_CORNER"
