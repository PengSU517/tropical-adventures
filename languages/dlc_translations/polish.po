msgstr "O, spójrz. Śpi sobie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POISONCROCODOG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POISONCROCODOG"
msgid "It won't obey me."
msgstr "Nie słucha się moich rozkazów."

