msgstr "Woodlegs ma w nosie zasady."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DECO_WALLORNAMENT_PERIODIC_TABLE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DECO_WALLORNAMENT_PERIODIC_TABLE"
