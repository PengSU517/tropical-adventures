msgstr "Łukowate."

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_LAMP_EDISON
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_LAMP_EDISON"
