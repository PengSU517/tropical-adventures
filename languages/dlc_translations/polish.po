msgstr "Koło ratunkowe."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DECO_WOOD
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DECO_WOOD"
