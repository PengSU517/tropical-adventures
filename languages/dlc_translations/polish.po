#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PORKLAND_INTRO_FLAGS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PORKLAND_INTRO_FLAGS"
