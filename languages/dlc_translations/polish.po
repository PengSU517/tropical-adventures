msgstr "Ten mur mnie nie powstrzyma!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEDGE.SHAVEABLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEDGE.SHAVEABLE"
