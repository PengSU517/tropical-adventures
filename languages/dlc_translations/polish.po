msgstr "Woskowate."

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_LAMP_CERAMIC
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_LAMP_CERAMIC"
