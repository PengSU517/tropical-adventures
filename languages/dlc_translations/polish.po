msgstr "Przepadam za pieczonymi warzywami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIG_SHOP_PRODUCE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIG_SHOP_PRODUCE.GENERIC"
