msgstr "Płoń! Płoń! Płoń!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_DELI.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_DELI.GENERIC"
