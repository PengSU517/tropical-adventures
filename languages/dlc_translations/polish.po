msgstr "Arr! Cóż to za szczur lądowy?"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DECO_WALLORNAMENT_WREATH
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DECO_WALLORNAMENT_WREATH"
