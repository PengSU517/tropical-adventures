msgstr "Moje własne dzieło."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.EGGPLANT_SEEDS"
