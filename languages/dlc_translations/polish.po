msgstr "Dyfrakcyjne."

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_LAMP_DOWNBRIDGE
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_LAMP_DOWNBRIDGE"
