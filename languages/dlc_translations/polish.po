msgstr "Biedny statek powietrzny."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DEFLATED_BALLOON_BASKET
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DEFLATED_BALLOON_BASKET"
