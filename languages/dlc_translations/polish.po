msgstr "Trzeba z nią uważać."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.VOLCANO_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.VOLCANO_ALTAR.GENERIC"
