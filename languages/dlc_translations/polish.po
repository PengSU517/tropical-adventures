msgstr "Miejsce na manele."

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SHIPWRECKED_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SHIPWRECKED_ENTRANCE"
