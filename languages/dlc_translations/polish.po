msgstr "Niezbyt gorący."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEA_CHIMINEA.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEA_CHIMINEA.GENERIC"
