msgstr "Jest nowy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORKLAND_INTRO_BALLOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORKLAND_INTRO_BALLOON"
