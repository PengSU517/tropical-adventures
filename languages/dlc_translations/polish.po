msgstr "Symbol podboju!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOGUSPORKUSATOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOGUSPORKUSATOR"
