msgstr "Galaretowate."

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SLUGBUG_COOKED
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SLUGBUG_COOKED"
