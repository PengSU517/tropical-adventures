msgstr "Musi się znaleźć na ziemi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HEDGE_LAYERED_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HEDGE_LAYERED_ITEM"
