msgstr "Czarny. Jak me serce."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECO_WALLORNAMENT_CAPE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECO_WALLORNAMENT_CAPE"
