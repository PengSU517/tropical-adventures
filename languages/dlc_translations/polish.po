msgstr "Bydlęce."

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_ANTIQUITIES_WALLFISH
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DECO_ANTIQUITIES_WALLFISH"
