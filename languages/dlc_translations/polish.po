msgstr "Ładne!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUG_HOOFPRINT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUG_HOOFPRINT"
