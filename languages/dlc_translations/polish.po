msgstr "Jeszcze chwila."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENT_ROBOT_CLAW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENT_ROBOT_CLAW"
