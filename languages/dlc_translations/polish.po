msgstr "To harpuny."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DECO_WALLORNAMENT_MOSAIC
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DECO_WALLORNAMENT_MOSAIC"
