msgstr "Element jakiego czegoś."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_SW_CRANK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_SW_CRANK"
