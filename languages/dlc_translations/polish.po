msgstr "Nie wygląda na coś łatwopalnego."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_RUINS_IDOL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_RUINS_IDOL"
