#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.INTERIOR_WALL_WOOD
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.INTERIOR_WALL_WOOD"
