msgstr "To miasto ma problem z wandalizmem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIG_SHOP_CITYHALL_PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIG_SHOP_CITYHALL_PLAYER.GENERIC"
