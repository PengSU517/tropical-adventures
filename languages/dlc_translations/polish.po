msgstr "Ciekawe, do czego to służy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_SW_RING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_SW_RING"
