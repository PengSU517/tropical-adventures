msgstr "Solidny bezanmaszt."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DECO_WOOD_CORNERBEAM
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DECO_WOOD_CORNERBEAM"
