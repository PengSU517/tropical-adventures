msgstr "Ciekawe, jak do tego doszło."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_SHOP_HOOFSPA.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_SHOP_HOOFSPA.GENERIC"
