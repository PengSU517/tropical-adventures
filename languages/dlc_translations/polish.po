msgstr "Wygląda jeszcze pyszniej!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SWEET_POTATO_PLANTED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SWEET_POTATO_PLANTED"
