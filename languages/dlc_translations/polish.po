#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.INTERIOR_WALL_ROPE
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.INTERIOR_WALL_ROPE"
