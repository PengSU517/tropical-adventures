msgstr "Pali się."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_SHOP_DELI.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_SHOP_DELI.GENERIC"
