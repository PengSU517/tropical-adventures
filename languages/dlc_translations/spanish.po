msgstr "Supongo que funciona."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHELVES_HOOKS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHELVES_HOOKS"
