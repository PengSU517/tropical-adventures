msgstr "¡Está ardiendo!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIG_GUARD_TOWER_PALACE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIG_GUARD_TOWER_PALACE.GENERIC"
