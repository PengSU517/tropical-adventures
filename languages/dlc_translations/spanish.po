msgstr "Hola, árbol del té."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TEATREE_NUT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TEATREE_NUT"
