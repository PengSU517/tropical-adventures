msgstr "Hmmm, ha soltado esto."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.DOYDOYNEST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.DOYDOYNEST"
