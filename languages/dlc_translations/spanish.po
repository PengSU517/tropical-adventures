msgstr "El nido de un Strigiformes."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.THUNDERHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.THUNDERHAT"
