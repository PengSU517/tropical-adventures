msgstr "Sin asomo de vida."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ADULT_FLYTRAP.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ADULT_FLYTRAP.GENERIC"
