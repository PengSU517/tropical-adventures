msgstr "¡Casi se ha acabado...!"

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
