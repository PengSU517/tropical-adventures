msgstr "Un pájaro azulón."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PARROT_BLUE.SLEEPING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PARROT_BLUE.SLEEPING"
