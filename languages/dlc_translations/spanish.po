msgstr "Uy."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECONSTRUCTION_PROJECT.SCAFFOLD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECONSTRUCTION_PROJECT.SCAFFOLD"
