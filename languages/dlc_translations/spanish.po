msgstr "Está durmiendo. Me gustaría saber qué se siente."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN_MINER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN_MINER.GENERIC"
