msgstr "Interesante. Parece estar soñando."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN_HATMAKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN_HATMAKER.GENERIC"
