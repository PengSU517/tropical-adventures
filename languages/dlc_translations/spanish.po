msgstr "La entrada a un laberinto subterráneo de salas antiguas."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_RUINS_EXIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_RUINS_EXIT"
