msgstr "Una guarida de chupasangres."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.VAMPIRE_BAT_WING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.VAMPIRE_BAT_WING"
