msgstr "Es un antiguo brasero porcino."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_RUINS_TORCH_WALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_RUINS_TORCH_WALL"
