msgstr "Agh. Cómo pesa la piedra. Y no arde nada."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLAYER_HOUSE_VILLA_CRAFT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLAYER_HOUSE_VILLA_CRAFT"
