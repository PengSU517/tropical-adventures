msgstr "Se cascó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROC_NEST_HOUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROC_NEST_HOUSE"
