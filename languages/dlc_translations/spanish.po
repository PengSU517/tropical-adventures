msgstr "Tu aventura ha tocado fin. La mía acaba de empezar."

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.DECIDUOUSTREE.BURNING"
