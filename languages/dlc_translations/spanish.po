msgstr "Molaaa. Qué pluma tan chula."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.FEIJOADA
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.FEIJOADA"
