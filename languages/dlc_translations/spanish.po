msgstr "Espero que no quiera recuperarlo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENT_ROBOTS_ASSEMBLY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENT_ROBOTS_ASSEMBLY"
