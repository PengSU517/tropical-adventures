msgstr "¡Tiene pinta de haber sido un incendio glorioso!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLAYERHOUSE_CITY.FORSALE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLAYERHOUSE_CITY.FORSALE"
