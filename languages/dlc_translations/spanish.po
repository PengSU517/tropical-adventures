msgstr "Eh, no me pinches."

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.NETTLE.DEFAULT
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.NETTLE.DEFAULT"
