msgstr "Es un árbol."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RAINFORESTTREE_ROT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RAINFORESTTREE_ROT"
