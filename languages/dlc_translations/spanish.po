msgstr "Tiene la ira en sus ojos."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.LIVINGJUNGLETREE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.LIVINGJUNGLETREE"
