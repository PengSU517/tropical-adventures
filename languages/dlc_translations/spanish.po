msgstr "Alguien lo ha cortado."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROC_NEST_EGG2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROC_NEST_EGG2"
