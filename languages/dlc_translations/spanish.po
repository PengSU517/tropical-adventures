msgstr "Se está quedando sin combustible."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TAR_EXTRACTOR.OFF
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TAR_EXTRACTOR.OFF"
