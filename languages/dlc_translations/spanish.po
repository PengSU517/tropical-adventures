msgstr "Puedes quedarte con todos mis dulces. No me importa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN_USHER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN_USHER.SLEEPING"
