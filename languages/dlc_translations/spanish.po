msgstr "Aún no puedo talarlo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROC_NEST_TRUNK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROC_NEST_TRUNK"
