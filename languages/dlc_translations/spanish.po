msgstr "Alguien lo tendría como oro en paño."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RELIC_4
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RELIC_4"
