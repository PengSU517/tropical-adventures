msgstr "Bah... No creo que valga gran cosa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GOOSE_FEATHER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GOOSE_FEATHER"
