msgstr "Desconozco cuál es su función."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TELEPORTATO_HAMLET_POTATO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TELEPORTATO_HAMLET_POTATO"
