msgstr "Un revuelto peligroso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FROG_POISON.DEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FROG_POISON.DEAD"
