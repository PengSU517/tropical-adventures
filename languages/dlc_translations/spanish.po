msgstr "Con esto mi bote se mantendrá a flote."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_LANTERN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_LANTERN"
