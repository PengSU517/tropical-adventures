msgstr "Troglodita."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHELVES_LADDER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHELVES_LADDER"
