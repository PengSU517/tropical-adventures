msgstr "No vendrá mal algo de luz."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_SCEPTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_SCEPTER"
