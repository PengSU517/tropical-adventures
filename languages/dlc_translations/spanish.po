msgstr "No estoy seguro de cómo sobrevive este bicho."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DOYDOYBABY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DOYDOYBABY"
