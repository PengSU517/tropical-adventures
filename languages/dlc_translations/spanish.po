msgstr "Se está echando una cabezada."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PEAGAWKFEATHER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PEAGAWKFEATHER"
