msgstr "¡Mecachis! ¡Todo ese conocimiento en llamas!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_SHOP_ACADEMY.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_SHOP_ACADEMY.GENERIC"
