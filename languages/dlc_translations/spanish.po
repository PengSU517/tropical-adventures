msgstr "No tiene pinta de que podamos cortarlo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROC_NEST_TREE2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROC_NEST_TREE2"
