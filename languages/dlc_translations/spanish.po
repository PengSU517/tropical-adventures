msgstr "Parece... divertido."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PORKLAND_EXIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PORKLAND_EXIT"
