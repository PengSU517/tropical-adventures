msgstr "Ostras. ¡Una pata de pollo enorme!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROC_NEST_BRANCH1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROC_NEST_BRANCH1"
