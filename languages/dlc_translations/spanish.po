msgstr "Maduro para la recogida."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BIGFISHINGROD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BIGFISHINGROD"
