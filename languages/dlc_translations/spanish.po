msgstr "¡Ahhh! ¡Las cosas se están calentando!"

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
