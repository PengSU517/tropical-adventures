msgstr "Maduro para la recogida."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BERRYBUSH_SNAKE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BERRYBUSH_SNAKE"
