msgstr "Está claro que es un regulador, pero no sé para qué."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TELEPORTATO_HAMLET_CRANK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TELEPORTATO_HAMLET_CRANK"
