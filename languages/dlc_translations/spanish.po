msgstr "Una armadura hecha del exoesqueleto de un bicho."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_WINDBREAKER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_WINDBREAKER"
