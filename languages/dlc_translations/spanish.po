msgstr "Tocará cambiar eso luego."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINDOW_ROUND_CURTAINS_NAILS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINDOW_ROUND_CURTAINS_NAILS"
