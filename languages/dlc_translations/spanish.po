msgstr "Un palo. Un poco viejuno."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROC_NEST_EGG1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROC_NEST_EGG1"
