msgstr "Me está buscando."

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.EYETURRET_ITEM"
