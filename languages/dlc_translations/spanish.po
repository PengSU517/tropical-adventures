msgstr "Mi padre usaba una de estas."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECONSTRUCTION_PROJECT.RUBBLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECONSTRUCTION_PROJECT.RUBBLE"
