msgstr "¡Al suelo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.DUG_BUSH_VINE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.DUG_BUSH_VINE"
