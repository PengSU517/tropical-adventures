msgstr "Está en llamas."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_GUARD_TOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_GUARD_TOWER.GENERIC"
