msgstr "Parece una rama pesada."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROC_NEST_BUSH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROC_NEST_BUSH"
