msgstr "Solo el veneno puede curar el veneno."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.VENUS_STALK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.VENUS_STALK"
