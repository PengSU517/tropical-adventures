msgstr "¡Abrámoslo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.KRAKEN_TENTACLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.KRAKEN_TENTACLE"
