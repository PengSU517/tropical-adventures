msgstr "Un exloro."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PARROT_BLUE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PARROT_BLUE.GENERIC"
