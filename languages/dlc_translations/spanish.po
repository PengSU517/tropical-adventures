msgstr "Se ha ido como la luz."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLOWFLY_COCOON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLOWFLY_COCOON"
