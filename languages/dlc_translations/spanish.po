msgstr "Me encanta su color."

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.FEATHER_ROBIN_WINTER"
