msgstr "Se diría que es rompible."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHELVES_HATTREE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHELVES_HATTREE"
