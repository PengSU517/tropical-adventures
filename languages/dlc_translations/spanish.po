msgstr "¡Arde! ¡Sí!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BURR_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BURR_SAPLING.GENERIC"
