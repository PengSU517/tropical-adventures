msgstr "Un buen antihistamínico."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TEATREE_NUT_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TEATREE_NUT_COOKED"
