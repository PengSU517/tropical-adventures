msgstr "Un asunto de lo más espinado."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BRAMBLE_BULB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BRAMBLE_BULB"
