msgstr "¿Queremos otro palo?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROC_NEST_DEBRIS3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROC_NEST_DEBRIS3"
