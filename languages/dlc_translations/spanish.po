msgstr "Una llave muy regia."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PEEKHEN.DEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PEEKHEN.DEAD"
