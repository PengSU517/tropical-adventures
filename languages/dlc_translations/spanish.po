msgstr "El color no me inspira demasiada confianza."

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DOYDOYEGG_CRACKED
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DOYDOYEGG_CRACKED"
