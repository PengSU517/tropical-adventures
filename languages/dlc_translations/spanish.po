msgstr "¡Mira! Un arbusto irisado."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PEDESTAL_KEY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PEDESTAL_KEY"
