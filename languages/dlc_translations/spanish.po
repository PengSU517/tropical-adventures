msgstr "Esos párpados en movimiento indican sueño REM."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN_ROYALGUARD_2.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN_ROYALGUARD_2.GENERIC"
