msgstr "Adiós, bambú."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BAMBOOTREE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BAMBOOTREE.BURNT"
