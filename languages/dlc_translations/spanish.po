msgstr "Una eucariota multicelular."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TIGEREYE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TIGEREYE"
