msgstr "Un montón ordinario de arena."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHARK_FIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHARK_FIN"
