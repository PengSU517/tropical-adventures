msgstr "Pss. Ha durado poco."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PORKLAND_INTRO_FLAGS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PORKLAND_INTRO_FLAGS"
