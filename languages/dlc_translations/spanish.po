msgstr "Inerte."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PEEKHEN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PEEKHEN.GENERIC"
