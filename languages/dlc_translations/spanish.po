msgstr "¿Estoy de humor para explorar?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_RUINS_ENTRANCE_SMALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_RUINS_ENTRANCE_SMALL"
