msgstr "Supongo que funciona."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHELVES_WALLMOUNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHELVES_WALLMOUNT"
