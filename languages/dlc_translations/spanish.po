msgstr "¡Qué miedo!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.VOLCANO_EXIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.VOLCANO_EXIT"
