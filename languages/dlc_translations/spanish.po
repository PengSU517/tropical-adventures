msgstr "¡Mola!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_OBSIDIAN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_OBSIDIAN"
