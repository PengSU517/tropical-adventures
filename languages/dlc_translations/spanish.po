msgstr "¡Está adquiriendo fuerza!"

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.NIGHTSTICK"
