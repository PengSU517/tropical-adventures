msgstr "Ah. Un sitio para poner mis libros."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHELVES_INDUSTRIAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHELVES_INDUSTRIAL"
