msgstr "Adiós la luz... para siempre."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLOWFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLOWFLY.GENERIC"
