msgstr "Huele tal y como sabe."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASPARAGUS_COOKED"
