msgstr "Una torre fortificada para la guardia real."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_GUARD_TOWER_PALACE.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_GUARD_TOWER_PALACE.BURNING"
