msgstr "Sin sentido. No puedo ni quemarlo."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PORKLAND_INTRO_BASKET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PORKLAND_INTRO_BASKET"
