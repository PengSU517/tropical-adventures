msgstr "¡Cuidado, que está armado!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENT_ROBOT_HEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENT_ROBOT_HEAD"
