msgstr "¡Estoy listo para zarpar!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODLEGS_CAGE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODLEGS_CAGE"
