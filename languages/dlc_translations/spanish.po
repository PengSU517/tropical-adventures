msgstr "Un anfibio en consonancia conmigo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SNAKE_BONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SNAKE_BONE"
