msgstr "No es carne y está verde."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TUBER_CROP_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TUBER_CROP_COOKED"
