#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TELEPORTATO_HAMLET_BOX
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TELEPORTATO_HAMLET_BOX"
