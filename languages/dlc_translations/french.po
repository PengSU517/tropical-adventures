msgstr "Ses secrets de fabricatiön serönt bientöt miens !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_WEAPONS.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_WEAPONS.BURNING"
