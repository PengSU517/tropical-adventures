msgstr "Puissent des batailles m'y attendre !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_RUINS_ENTRANCE_SMALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_RUINS_ENTRANCE_SMALL"
