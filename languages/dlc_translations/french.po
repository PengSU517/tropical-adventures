msgstr "Je me demande s'il a assez d'eau."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MANGROVETREE_BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MANGROVETREE_BURNT"
