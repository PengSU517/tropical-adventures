msgstr "Immonde volatile."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHICKEN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHICKEN.SLEEPING"
