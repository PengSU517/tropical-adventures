msgstr "Öccis."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIKO.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIKO.GENERIC"
