msgstr "Que le tröc cömmence !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_HATSHOP.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_HATSHOP.BURNING"
