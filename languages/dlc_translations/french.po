msgstr "Ça va tout griller."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_GUARD_TOWER_PALACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_GUARD_TOWER_PALACE.GENERIC"
