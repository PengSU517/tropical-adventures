msgstr "Ça soulage mon esprit."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAWPALMTREE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAWPALMTREE"
