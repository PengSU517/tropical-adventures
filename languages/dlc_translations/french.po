msgstr "Une odeur charmante."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOWERSALAD"
