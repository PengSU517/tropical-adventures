msgstr "Beurk."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUG_BRAID
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUG_BRAID"
msgid "A floor rug."
msgstr "Un tapis de sol."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUG_CATCOON
