msgstr "Un tapis de sol."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUG_OVAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUG_OVAL"
