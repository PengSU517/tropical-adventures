msgstr "Un vrai feftin de pirate !"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.HONEYNUGGETS"
