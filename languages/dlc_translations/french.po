msgstr "Un coffre qu'il est chouette."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLOTMACHINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLOTMACHINE"
