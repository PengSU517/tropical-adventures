msgstr "Tu resteras debout à mes côtés ?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_PIG_RUINS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_PIG_RUINS"
