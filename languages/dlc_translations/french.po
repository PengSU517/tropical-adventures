msgstr "C'est fermé."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODLEGS_KEY1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODLEGS_KEY1"
