msgstr "On est pas copains, tous les deux !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_MONKEY.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_MONKEY.SLEEPING"
