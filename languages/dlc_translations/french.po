msgstr "Je n'ai pas confiance en lui."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUGALISK_SKULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUGALISK_SKULL"
