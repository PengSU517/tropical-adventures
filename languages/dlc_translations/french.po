msgstr "Et voilà un arbre !"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIRATEGHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIRATEGHOST"
