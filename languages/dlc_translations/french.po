msgstr "F'est un ver !"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.WORMHOLE.GENERIC"
