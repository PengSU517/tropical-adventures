msgstr "Une sorte de messager."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_HULK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_HULK"
