msgstr "Viens te la mettre, cochonnet !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGMAN_BANKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGMAN_BANKER.GENERIC"
