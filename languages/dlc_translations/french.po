msgstr "Ça se mange, la bardane ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BURR_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BURR_SAPLING.GENERIC"
