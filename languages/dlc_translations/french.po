msgstr "Elle s'occupe de fleurs."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN_FLORIST.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN_FLORIST.SLEEPING"
