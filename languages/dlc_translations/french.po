msgstr "Brrrrrr !"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.WOODLEGSBOAT
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.WOODLEGSBOAT"
