msgstr "Y a pas pire."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ANT_CAVE_LANTERN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ANT_CAVE_LANTERN"
