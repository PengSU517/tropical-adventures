msgstr "J'ai besöin de moult viande !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_TINKER.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_TINKER.BURNING"
