msgstr "A besoin de feu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SWINGING_LIGHT_DERBY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SWINGING_LIGHT_DERBY"
