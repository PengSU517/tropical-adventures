msgstr "Tu feras un bien beau vaiffeau."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DECIDUOUSTREE.GENERIC"
