msgstr "Très riche en protéines."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEAWEED_DRIED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEAWEED_DRIED"
