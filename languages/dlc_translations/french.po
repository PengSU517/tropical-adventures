msgstr "De nombreuses cönquêtent s'y tröuvent !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_RUINS_EXIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_RUINS_EXIT"
