msgstr "Des öbjets pour söigner des blessures de guerre."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_PRODUCE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_PRODUCE.BURNING"
