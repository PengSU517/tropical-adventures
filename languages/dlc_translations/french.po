msgstr "Beurk !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPORE_MEDIUM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPORE_MEDIUM"
