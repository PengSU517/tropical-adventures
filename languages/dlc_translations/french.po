msgstr "Attrape-le ! Attrape-le !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPORE_TALL_INV
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPORE_TALL_INV"
