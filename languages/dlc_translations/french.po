msgstr "Je peux y creuser."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MAGMAROCK_FULL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MAGMAROCK_FULL"
