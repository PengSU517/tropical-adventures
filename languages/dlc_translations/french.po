msgstr "Je vengerai les armes !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_WEAPONS.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_WEAPONS.GENERIC"
