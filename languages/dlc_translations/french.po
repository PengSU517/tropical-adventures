msgstr "C'est éteint maintenant."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TAR_EXTRACTOR.ON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TAR_EXTRACTOR.ON"
