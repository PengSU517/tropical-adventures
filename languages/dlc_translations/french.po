msgstr "Comme c'est pratique..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAWPALMTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAWPALMTREE_SAPLING"
