msgstr "Ça mène où ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_RUINS_EXIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_RUINS_EXIT"
