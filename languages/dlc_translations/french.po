msgstr "Ça vient de cet abruti apocalyptique."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ANCIENT_ROBOTS_ASSEMBLY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ANCIENT_ROBOTS_ASSEMBLY"
