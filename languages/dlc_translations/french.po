msgstr "Je ferais mieux de ne pas déranger."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_MONKEY_TREE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_MONKEY_TREE"
