msgstr "Ah-ha ! Ces pièges föurbes ne prennent pas avec möi !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_RUINS_ENTRANCE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_RUINS_ENTRANCE.GENERIC"
