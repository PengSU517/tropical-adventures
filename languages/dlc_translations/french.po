msgstr "Puisse une bataille s'y tröuver !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_RUINS_ENTRANCE.LOCKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_RUINS_ENTRANCE.LOCKED"
