msgstr "Il en a fini."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SNAKEDEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SNAKEDEN.CHOPPED"
