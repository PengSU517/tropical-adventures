msgstr "Paresseux."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN_ERUDITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN_ERUDITE.GENERIC"
