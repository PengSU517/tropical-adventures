msgstr "Mon chef n'a guère besöin que d'un bön heaume de bataille !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_HOOFSPA.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_HOOFSPA.BURNING"
