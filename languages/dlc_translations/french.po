msgstr "De la bouillie orange."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SWEET_POTATO_PLANTED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SWEET_POTATO_PLANTED"
