#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_CITYHALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_CITYHALL.GENERIC"
