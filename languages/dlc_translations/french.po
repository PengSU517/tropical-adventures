msgstr "Bien moins puissant maintenant !"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.BUILD.MOUNTED
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.BUILD.MOUNTED"
