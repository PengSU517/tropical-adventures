msgstr "C'est un peu comme des sabords."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.WINDOW_ROUND
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.WINDOW_ROUND"
