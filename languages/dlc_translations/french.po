msgstr "Quelqu'un me le paiera."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYERHOUSE_CITY.FORSALE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYERHOUSE_CITY.FORSALE"
