msgstr "Détestable."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLUGBUG_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLUGBUG_COOKED"
