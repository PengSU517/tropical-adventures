msgstr "T'as l'air canon, ma grande !"

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.PIGMAN_BEAUTICIAN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.PIGMAN_BEAUTICIAN.SLEEPING"
