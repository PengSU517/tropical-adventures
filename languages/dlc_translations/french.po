msgstr "Mieux vaut éviter de trop s'approcher."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_MONKEY_NEST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_MONKEY_NEST"
