msgstr "T'es un bon combattant."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DECIDUOUSTREE.BURNING"
