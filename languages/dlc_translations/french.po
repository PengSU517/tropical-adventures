msgstr "J'anticipe déjà les brûlures d'estomac !"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEAGULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEAGULL"
