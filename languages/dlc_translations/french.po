msgstr "En flammes !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_GUARD_TOWER_PALACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_GUARD_TOWER_PALACE.GENERIC"
