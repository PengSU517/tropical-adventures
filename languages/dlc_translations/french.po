msgstr "Oh, toi je t'aime !"

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.OBSIDIAN_WORKBENCH
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.OBSIDIAN_WORKBENCH"
