msgstr "Ö, majestueuse dame !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN_ROYALGUARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN_ROYALGUARD.GENERIC"
