msgstr "Comme c'est macabre."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUGALISK_TRAP_DOOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUGALISK_TRAP_DOOR"
