msgstr "Mieux vaut ne pas s'en approcher."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_RUINS_SPEAR_TRAP_BROKEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_RUINS_SPEAR_TRAP_BROKEN"
