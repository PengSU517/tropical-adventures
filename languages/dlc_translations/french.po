msgstr "C'est pas un petit incendie, hein ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_SHOP_PRODUCE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_SHOP_PRODUCE.GENERIC"
