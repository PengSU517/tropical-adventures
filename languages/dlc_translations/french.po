msgstr "J'aimerais pouvoir faire comme elle."

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.PIGMAN_FARMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.PIGMAN_FARMER.GENERIC"
