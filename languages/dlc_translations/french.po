msgstr "Ça tourne vraiment bien !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TAR_POOL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TAR_POOL"
