msgstr "Aah !"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TRAWL_FULL
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TRAWL_FULL"
msgid "My trawl is ready to reel in."
