msgstr "C'est pour nos éternuements."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TEATREE_NUT_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TEATREE_NUT_COOKED"
