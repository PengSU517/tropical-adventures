msgstr "Grrroarrr !"

#. STRINGS.CHARACTERS.WILLOW.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WILLOW.BATTLECRY.SPIDER_WARRIOR"
