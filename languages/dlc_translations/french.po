msgstr "Moche."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ANCIENT_ROBOT_LEG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ANCIENT_ROBOT_LEG"
