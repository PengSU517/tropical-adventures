msgstr "Hmmm.. Devrais-je investir dans l'immobilier ici ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYERHOUSE_CITY.SOLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYERHOUSE_CITY.SOLD"
