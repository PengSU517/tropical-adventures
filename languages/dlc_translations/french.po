msgstr "Ce nuisible est endormi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIKO_ORANGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIKO_ORANGE"
