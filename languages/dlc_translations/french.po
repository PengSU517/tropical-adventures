msgstr "L'vieux Woodlegs a pas vraiment la main verte."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.HEDGE_CONE_ITEM
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.HEDGE_CONE_ITEM"
