msgstr "Bons cauchemars."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN_FARMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN_FARMER.GENERIC"
