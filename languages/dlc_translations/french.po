msgstr "C'est un bâton."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROC_NEST_EGG1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROC_NEST_EGG1"
