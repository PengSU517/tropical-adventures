msgstr "Ça m'sera pas bien utile comme ça."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.HEDGE_LAYERED_ITEM
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.HEDGE_LAYERED_ITEM"
