msgstr "Il manque des morceaux."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_HERALD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_HERALD"
