msgstr "Sympa cette source de lumière."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_RUINS_TORCH_WALL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_RUINS_TORCH_WALL"
