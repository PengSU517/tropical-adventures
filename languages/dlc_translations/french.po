msgstr "Charmant..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUG_OCTAGON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUG_OCTAGON"
