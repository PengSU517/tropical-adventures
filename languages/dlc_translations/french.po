msgstr "Il ne voguera plus jamais."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUNKEN_BOAT_BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUNKEN_BOAT_BURNT"
