msgstr "Cönsumé par le feu !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_HOOFSPA.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_HOOFSPA.GENERIC"
