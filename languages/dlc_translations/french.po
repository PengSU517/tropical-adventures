msgstr "On veut en manger !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SWEET_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SWEET_POTATO_SEEDS"
