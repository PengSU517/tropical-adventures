#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PICKPOOP.2
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PICKPOOP.2"
msgid "Gross!"
msgstr "Widerlich!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PICKPOOP.3
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PICKPOOP.3"
