msgstr "Ich höre das Meer."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.SEASHELL_BEACHED
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.SEASHELL_BEACHED"
