msgstr "Verstorben."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCORPION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCORPION.GENERIC"
