msgstr "Lecker schmecker."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.SWEET_POTATO
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.SWEET_POTATO"
