msgstr "FORT!"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
