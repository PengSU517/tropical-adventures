msgstr "Das Museum steht in Flammen!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_SHOP_ACADEMY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_SHOP_ACADEMY.GENERIC"
