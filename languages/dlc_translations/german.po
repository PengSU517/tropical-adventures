msgstr "Scheint kaum was wert."

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.GOGGLESSHOOTHAT
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.GOGGLESSHOOTHAT"
