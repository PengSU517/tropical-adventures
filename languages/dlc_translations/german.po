msgstr "Der Albtraum wird sein wahres Potential freisetzen."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
