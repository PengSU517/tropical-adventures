#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SWINGING_LIGHT_BASIC_BULB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SWINGING_LIGHT_BASIC_BULB"
