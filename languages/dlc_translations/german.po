msgstr "Jemand sollte löschen, wie?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_SHOP_BANK.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_SHOP_BANK.GENERIC"
