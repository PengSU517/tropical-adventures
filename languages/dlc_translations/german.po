msgstr "Ein Götze, doch keiner, dem ich huldige."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_GIFTSHOP_3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_GIFTSHOP_3"
