msgstr "Der macht mich glücklich."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARGOBOAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARGOBOAT"
