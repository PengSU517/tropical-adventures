msgstr "Leuchte mir, mon amie."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.GLOWFLY.SLEEPING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.GLOWFLY.SLEEPING"
