msgstr "Eine Einladung, etwas zusammenzusetzen."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TELEPORTATO_SW_BOX
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TELEPORTATO_SW_BOX"
