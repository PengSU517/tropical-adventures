msgctxt "STRINGS.CHARACTER_QUOTES.walani"
msgid "\"Forgive me if I don't get up. I don't want to.\""
msgstr "\"Verzeih, wenn ich nicht aufstehe. Ich hab keine Lust dazu.\""

