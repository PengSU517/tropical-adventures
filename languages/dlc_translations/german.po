msgstr "Himmelhoch"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.GRASS_TALL.PICKED
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.GRASS_TALL.PICKED"
