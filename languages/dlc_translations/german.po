msgstr "Wer war das?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_SHOP_CITYHALL_PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_SHOP_CITYHALL_PLAYER.GENERIC"
