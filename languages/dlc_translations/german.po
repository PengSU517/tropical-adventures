msgstr "Geplündert."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.GRASS_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.GRASS_UMBRELLA"
