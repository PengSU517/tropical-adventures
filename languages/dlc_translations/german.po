msgstr "Sieht kaputt aus."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENT_HERALD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENT_HERALD"
