msgstr "Holt mich hier raus!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT_ROC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT_ROC"
