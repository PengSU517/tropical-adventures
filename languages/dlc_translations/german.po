msgstr "Das war keine gute Idee!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT"
