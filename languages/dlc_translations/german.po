msgstr "Schleimig, aber sättigend."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLUGBUG_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLUGBUG_COOKED"
