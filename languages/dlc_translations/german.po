msgstr "Serpentes infernus."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SNAKE_POISON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SNAKE_POISON"
