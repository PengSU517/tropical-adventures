msgstr "Ein Landmast."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.ROC_NEST_TREE2
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.ROC_NEST_TREE2"
