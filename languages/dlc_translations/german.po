msgstr "Das muss angefacht werden."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.SEA_CHIMINEA.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.SEA_CHIMINEA.GENERIC"
