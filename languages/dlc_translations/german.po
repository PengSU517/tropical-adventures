msgstr "Das kann gekocht werden."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SWEET_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SWEET_POTATO_COOKED"
