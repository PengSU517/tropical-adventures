msgstr "Wird grimmig bewacht."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUNKEN_BOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUNKEN_BOAT.GENERIC"
