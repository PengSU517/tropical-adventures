msgstr "Am besten verbrennen!!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PUGALISK_INVULNERABLE.1
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PUGALISK_INVULNERABLE.1"
