msgstr "Aus echtem Seemannsgarn."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.SWEETPOTATOSOUFFLE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.SWEETPOTATOSOUFFLE"
