msgstr "Nicht mehr gut."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PORKLAND_INTRO_TRUNK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PORKLAND_INTRO_TRUNK"
