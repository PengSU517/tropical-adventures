msgstr "Kein bisschen Magie."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
