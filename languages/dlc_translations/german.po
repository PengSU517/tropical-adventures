msgstr "Es sinkt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TRAWLNETDROPPED.SOONISH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TRAWLNETDROPPED.SOONISH"
