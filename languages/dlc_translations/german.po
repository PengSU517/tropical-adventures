msgstr "Abrasiert."

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.EVERGREEN.GENERIC"
