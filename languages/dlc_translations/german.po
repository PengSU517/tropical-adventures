msgstr "Ein Landmast fern der Heimat."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.ROC_NEST_TRUNK
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.ROC_NEST_TRUNK"
