msgstr "Tja, das ist nicht gut."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_SHOP_HATSHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_SHOP_HATSHOP.GENERIC"
