msgstr "Uma nova conquista!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_RUINS_ENTRANCE3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_RUINS_ENTRANCE3"
