msgstr "Não vejo muitos desses nos mares."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.GREEN_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.GREEN_MUSHROOM.INGROUND"
