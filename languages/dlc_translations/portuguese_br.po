msgstr "Dois lampiões de casa elegantes."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DECO_LAMP_2FRINGES
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DECO_LAMP_2FRINGES"
