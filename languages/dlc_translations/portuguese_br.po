msgstr "Cochilando."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PIGMAN_MINER.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PIGMAN_MINER.GENERIC"
