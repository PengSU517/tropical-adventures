msgstr "O fogo de Hel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_GUARD_TOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_GUARD_TOWER.GENERIC"
