msgstr "Isso deve ter algum uso. Mas não sei qual é."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TELEPORTATO_HAMLET_POTATO
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TELEPORTATO_HAMLET_POTATO"
