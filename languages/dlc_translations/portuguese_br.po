msgstr "Gostamos desse."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUG_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUG_WORMHOLE"
