msgstr "Alguém deixou isso aí inacabado assim."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_HAMLET_BOX
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_HAMLET_BOX"
