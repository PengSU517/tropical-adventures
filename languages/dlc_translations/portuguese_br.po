msgstr "Essa árvore bebê está bem protegida pela armadura de espinhos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PINECONE.PLANTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PINECONE.PLANTED"
