msgstr "Acho que seria divertido escalar isso."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIG_RUINS_CREEPING_VINES
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIG_RUINS_CREEPING_VINES"
