msgstr "Meu local de trabalho."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_SHOP_DELI.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_SHOP_DELI.BURNING"
