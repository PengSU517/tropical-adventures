msgstr "Uma árvore carbonizada."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PALMTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PALMTREE.CHOPPED"
