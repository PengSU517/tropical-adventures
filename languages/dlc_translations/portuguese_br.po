msgstr "Anime-se, amigão!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WHALE_BUBBLES
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WHALE_BUBBLES"
