msgstr "Não é ideal para fazer sopa."

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DOUBLE_UMBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DOUBLE_UMBRELLAHAT"
