msgstr "Seria sensato evitar isso."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_RUINS_SPEAR_TRAP_BROKEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_RUINS_SPEAR_TRAP_BROKEN"
