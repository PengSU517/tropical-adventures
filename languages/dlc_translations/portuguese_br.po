msgstr "O faz-tudo da comunidade, acredito."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN_MECHANIC.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN_MECHANIC.SLEEPING"
