msgstr "Parece que ela tem uma constituição saudável."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN_BEAUTICIAN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN_BEAUTICIAN.SLEEPING"
