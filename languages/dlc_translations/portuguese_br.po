msgstr "Uma arma para fazendeiros."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PITHHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PITHHAT"
