msgstr "Não se meta comigo!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEAN_FLYTRAP.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEAN_FLYTRAP.SLEEPING"
