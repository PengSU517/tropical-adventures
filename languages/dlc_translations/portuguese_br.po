msgstr "Preocupado com suas necessidades hortícolas."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN_FLORIST.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN_FLORIST.SLEEPING"
