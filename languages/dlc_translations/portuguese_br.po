msgstr "É quentinho."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_CRANK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_CRANK"
