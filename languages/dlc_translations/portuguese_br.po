msgstr "Um lugar para deitar minha lança."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER_HOUSE_BRICK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER_HOUSE_BRICK"
