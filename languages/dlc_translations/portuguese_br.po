msgstr "O véi Woodlegs vai ficar com isso."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TELEPORTATO_HAMLET_RING
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TELEPORTATO_HAMLET_RING"
