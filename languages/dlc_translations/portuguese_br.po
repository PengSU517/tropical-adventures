msgstr "Um pedacinho do velho bloco."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIVINGJUNGLETREE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIVINGJUNGLETREE"
