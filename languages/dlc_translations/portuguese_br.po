msgstr "Arr, o Woodlegs vai virar isso."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TELEPORTATO_SW_POTATO
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TELEPORTATO_SW_POTATO"
