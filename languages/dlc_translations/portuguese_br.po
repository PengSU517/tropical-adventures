msgstr "Talvez eu impressione algumas Pavo Cristatusas."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEAGAWKFEATHER_PRISM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEAGAWKFEATHER_PRISM"
