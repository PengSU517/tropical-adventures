msgstr "Um simples pirata como eu não sabe pra que isso serve."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TELEPORTATO_CRANK
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TELEPORTATO_CRANK"
