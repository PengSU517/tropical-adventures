msgstr "O doutor bruxo disse pro Woodlegs que curaria minhas loucuras."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.GREEN_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.GREEN_MUSHROOM.GENERIC"
