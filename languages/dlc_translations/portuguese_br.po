msgstr "Um papagaio falecido."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PARROT_BLUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PARROT_BLUE.GENERIC"
