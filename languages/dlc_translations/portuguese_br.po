msgstr "Ahhh... meu acampamento base."

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.HOMESIGN.BURNT"
