msgstr "Um tipo de armadura para meu nariz e minha garganta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GASMASKHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GASMASKHAT"
