msgstr "Não é tão macio assim, né?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUG_NAILBED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUG_NAILBED"
