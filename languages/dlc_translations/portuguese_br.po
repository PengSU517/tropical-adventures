msgstr "Ah! Um marujo espectral!"

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.GIANTGRUB
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.GIANTGRUB"
