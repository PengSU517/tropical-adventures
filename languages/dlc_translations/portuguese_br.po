msgstr "Um elmo de visão turva."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOGGLESHEATHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOGGLESHEATHAT"
