msgstr "Pena do macho Pavo Cristatus."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEAGAWKFEATHERHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEAGAWKFEATHERHAT"
