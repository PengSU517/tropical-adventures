msgstr "Uma pena."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_SHOP_CITYHALL_PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_SHOP_CITYHALL_PLAYER.GENERIC"
