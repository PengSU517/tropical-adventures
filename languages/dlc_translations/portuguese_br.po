msgstr "Deve ter tido algum significado para os porcos."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_RUINS_CREEPING_VINES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_RUINS_CREEPING_VINES"
