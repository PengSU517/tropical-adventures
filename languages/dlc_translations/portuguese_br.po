msgstr "Olá, amigo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_COLLECTOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_COLLECTOR.SLEEPING"
