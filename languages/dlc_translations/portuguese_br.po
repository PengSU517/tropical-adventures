msgstr "Que peça mais curiosa!"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TELEPORTATO_SW_BOX
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TELEPORTATO_SW_BOX"
