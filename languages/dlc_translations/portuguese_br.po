msgstr "Voltaremos mais tarde."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_MAYOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_MAYOR.GENERIC"
