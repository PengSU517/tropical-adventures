msgstr "Tem um rosto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIVING_ARTIFACT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIVING_ARTIFACT"
