msgstr "Faz os músculos peitorais se desenvolverem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIRATIHATITATOR.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIRATIHATITATOR.BURNT"
