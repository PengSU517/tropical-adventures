msgstr "Um porco preocupado com ganho monetário."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN_BANKER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN_BANKER.SLEEPING"
