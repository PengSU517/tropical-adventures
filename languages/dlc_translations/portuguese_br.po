msgstr "Vamos nas pontas dos pés."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_STOREOWNER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_STOREOWNER.GENERIC"
