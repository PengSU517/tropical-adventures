msgstr "No processo de oxidação."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHOUSE_FARM.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHOUSE_FARM.GENERIC"
