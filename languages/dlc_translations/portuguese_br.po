msgstr "Vencida pelo sol."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLATE_DOOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLATE_DOOR"
