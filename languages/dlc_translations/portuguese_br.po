msgstr "Prometo encontrar um lugar para isso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEDGE_LAYERED_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEDGE_LAYERED_ITEM"
