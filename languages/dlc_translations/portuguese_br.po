msgstr "As armas estão em chamas."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_SHOP_WEAPONS.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_SHOP_WEAPONS.GENERIC"
