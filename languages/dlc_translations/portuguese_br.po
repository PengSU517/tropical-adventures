msgstr "Não há ninguém aqui além dos nossos amigos porcos."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_ROYALGUARD_2.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_ROYALGUARD_2.SLEEPING"
