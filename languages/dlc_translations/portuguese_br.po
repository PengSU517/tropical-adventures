msgstr "Saí!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_GAS_DAMAGE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_GAS_DAMAGE"
