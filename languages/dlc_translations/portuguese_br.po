msgstr "Vou levar isso comigo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_RUINS_PRESSURE_PLATE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_RUINS_PRESSURE_PLATE"
