msgstr "Olá, Sr. Prefeito!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_MAYOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_MAYOR.SLEEPING"
