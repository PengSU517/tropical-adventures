#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_DELI.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_DELI.GENERIC"
