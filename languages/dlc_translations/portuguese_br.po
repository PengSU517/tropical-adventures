#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEDGE_CONE_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEDGE_CONE_ITEM"
