msgstr "Arrgh. Meu pirata deve ser melhor do que isso."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.SWINGING_LIGHT_FLORAL_BLOOMER
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.SWINGING_LIGHT_FLORAL_BLOOMER"
