msgstr "Ups."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUSH_VINE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUSH_VINE.BURNT"
