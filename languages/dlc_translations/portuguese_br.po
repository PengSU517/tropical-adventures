msgstr "Uma folhagem aquática imensa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIMESTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIMESTONE"
