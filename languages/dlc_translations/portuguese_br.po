msgstr "Não olhe para mim! Arranja sua própria comida."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEBASE.GEMS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEBASE.GEMS"
