msgstr "Conheci muitos desses caras nas montanhas rochosas."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLUGBUG_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLUGBUG_COOKED"
