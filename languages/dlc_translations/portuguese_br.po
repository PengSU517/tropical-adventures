msgstr "Isso é uma pedra."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_BASALT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_BASALT"
