msgstr "Será que pode ler?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEACOCK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEACOCK"
