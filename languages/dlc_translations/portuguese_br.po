msgstr "Seus dentes dourados estão caçoando de mim!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_RUINS_PLAQUE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_RUINS_PLAQUE"
