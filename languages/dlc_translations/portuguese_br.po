msgstr "Corta, corta!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_ANTCAVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_ANTCAVE"
