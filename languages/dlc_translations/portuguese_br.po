msgstr "Deve ser legal voar... e comer lixo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEASACK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEASACK"
