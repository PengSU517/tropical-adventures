msgstr "Esse lugar guarda cortes deliciosos de carne!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_FLORIST.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_FLORIST.BURNING"
