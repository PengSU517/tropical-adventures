msgstr "Está a navegar."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.GUACAMOLE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.GUACAMOLE"
