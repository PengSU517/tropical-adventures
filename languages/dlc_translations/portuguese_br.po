msgstr "Olá!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_STOREOWNER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_STOREOWNER.SLEEPING"
