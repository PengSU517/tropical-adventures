msgstr "Para caçar insetos."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUGREPELLENT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUGREPELLENT"
