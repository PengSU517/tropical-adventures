msgstr "Tá bom. Eu levo isso."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_HAMLET_CRANK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_HAMLET_CRANK"
