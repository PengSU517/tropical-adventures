msgstr "Vejo as formas de algo muito lindo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_SW_BOX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_SW_BOX"
