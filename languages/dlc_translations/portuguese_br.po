msgstr "É exatamente a coisa que eu estava procurando."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_HAMLET_CRANK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_HAMLET_CRANK"
