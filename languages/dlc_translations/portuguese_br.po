msgstr "Ele está furioso!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_BANKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_BANKER.GENERIC"
