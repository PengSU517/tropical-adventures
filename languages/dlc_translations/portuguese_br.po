msgstr "Bem, isso não vai voltar."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SNAKEDEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SNAKEDEN.CHOPPED"
