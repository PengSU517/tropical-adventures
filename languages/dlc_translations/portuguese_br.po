#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TELEPORTATO_SW_BASE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TELEPORTATO_SW_BASE"
