msgstr "Um excelente recurso."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_SHOP_WEAPONS.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_SHOP_WEAPONS.BURNING"
