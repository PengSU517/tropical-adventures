msgstr "Está quase pronto."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TELEPORTATO_BOX
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TELEPORTATO_BOX"
