msgstr "O fogo a consumiu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_CITYHALL_PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_SHOP_CITYHALL_PLAYER.GENERIC"
