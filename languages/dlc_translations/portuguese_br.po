msgstr "Tenho certeza que a cobra não precisava disso."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SNAKESKINHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SNAKESKINHAT"
