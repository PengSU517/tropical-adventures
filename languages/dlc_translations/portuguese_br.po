msgstr "Um dos truques do Loki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOGGLESNORMALHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOGGLESNORMALHAT"
