msgstr "E aqui esqueci meu babador."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOBSTERHOLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOBSTERHOLE"
