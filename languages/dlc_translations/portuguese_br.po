msgstr "Nossa, que coisa estranha."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TELEPORTATO_HAMLET_CRANK
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TELEPORTATO_HAMLET_CRANK"
