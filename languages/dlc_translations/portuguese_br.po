msgstr "Não é mais tão perigosa quanto antes."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_RUINS_SPEAR_TRAP_TRIGGERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_RUINS_SPEAR_TRAP_TRIGGERED"
