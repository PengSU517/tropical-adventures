msgstr "Excelente. Não falta muito agora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_SW_POTATO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_SW_POTATO"
