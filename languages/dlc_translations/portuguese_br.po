msgstr "Não consigo subir nessa árvore."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROC_NEST_TREE2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROC_NEST_TREE2"
