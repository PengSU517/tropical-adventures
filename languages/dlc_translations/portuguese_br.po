msgstr "Essa pedra parece obra de Loki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_RUINS_SPEAR_TRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_RUINS_SPEAR_TRAP"
