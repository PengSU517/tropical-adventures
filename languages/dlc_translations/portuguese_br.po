msgstr "Olá, meu camarada aracnídeo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCORPION.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCORPION.SLEEPING"
