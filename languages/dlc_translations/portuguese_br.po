msgstr "Olá? Tem alguém em casa?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROC_NEST_RUSTY_LAMP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROC_NEST_RUSTY_LAMP"
