msgstr "Mal posso esperar para te comer."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LOCKEDWES
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LOCKEDWES"
