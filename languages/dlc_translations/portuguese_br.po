msgstr "Essa pedra parece estar fora do lugar."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_RUINS_SPEAR_TRAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_RUINS_SPEAR_TRAP"
