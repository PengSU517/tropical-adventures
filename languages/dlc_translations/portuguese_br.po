msgstr "Onde está o resto?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_HAMLET_POTATO
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_HAMLET_POTATO"
