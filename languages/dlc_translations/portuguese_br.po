msgstr "Sua magia foi soprada como brasa ao vento."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIRATIHATITATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIRATIHATITATOR.GENERIC"
