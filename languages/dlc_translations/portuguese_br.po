msgstr "É um porco licantrópico."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN_BANKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN_BANKER.GENERIC"
