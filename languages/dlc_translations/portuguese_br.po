msgstr "Um zumbido."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TELEPORTATO_POTATO
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TELEPORTATO_POTATO"
