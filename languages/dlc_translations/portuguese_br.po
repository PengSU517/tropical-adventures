msgstr "Mamãe sempre me disse para respeitar os mais velhos."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_PROFESSOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_PROFESSOR.SLEEPING"
