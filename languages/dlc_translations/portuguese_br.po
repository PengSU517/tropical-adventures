msgstr "Tem uma vela estranha no convés."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.RUG_RUBBERMAT
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.RUG_RUBBERMAT"
