msgstr "Um cardume!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.FISH_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.FISH_FARM.EMPTY"
