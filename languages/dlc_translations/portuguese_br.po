msgstr "Não funciona."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROC_NEST_TREE1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROC_NEST_TREE1"
