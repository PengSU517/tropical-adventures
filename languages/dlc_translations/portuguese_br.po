msgstr "Permite que os raios do sol entrem."

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.WINDOW_LARGE_SQUARE_CURTAIN
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.WINDOW_LARGE_SQUARE_CURTAIN"
