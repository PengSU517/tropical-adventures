msgstr "Foi pilhado!"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.HEDGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.HEDGE.GENERIC"
