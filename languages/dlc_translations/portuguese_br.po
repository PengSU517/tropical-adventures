msgstr "Bons sonhos, porquinho."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_ERUDITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_ERUDITE.GENERIC"
