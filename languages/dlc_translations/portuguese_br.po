msgstr "Um bom tapete pros navios."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.RUG_SQUARE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.RUG_SQUARE"
