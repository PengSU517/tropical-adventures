msgstr "Para Hel, espírito!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIRATEHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIRATEHAT"
