msgstr "Incendiei e agora posso comer isso."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TEATREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TEATREE_SAPLING"
