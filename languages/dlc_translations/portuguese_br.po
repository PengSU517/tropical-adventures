msgstr "Moeda suína."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_GUARD_TOWER.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_GUARD_TOWER.BURNING"
