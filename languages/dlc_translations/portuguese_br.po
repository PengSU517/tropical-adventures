msgstr "A casa de um funcionário eleito."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_SHOP_CITYHALL_PLAYER.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_SHOP_CITYHALL_PLAYER.BURNING"
