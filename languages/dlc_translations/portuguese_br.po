msgstr "Eu me prepararei para a batalha aí dentro!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIKE_SKULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIKE_SKULL"
