msgstr "Estou pronto para a aventura, hã!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHIPWRECKED_EXIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHIPWRECKED_EXIT"
