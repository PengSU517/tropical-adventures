msgstr "Nenhum peixinho."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.FISH_FARM.ONEFISH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.FISH_FARM.ONEFISH"
