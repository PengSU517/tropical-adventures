msgstr "Esse tapete é legalzinho."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUG_WEB
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUG_WEB"
