msgstr "Seria mais fofo pegando fogo!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SWEET_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SWEET_POTATO_SEEDS"
