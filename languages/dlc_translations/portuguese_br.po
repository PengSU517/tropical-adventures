msgstr "Ele parece ter cochilado."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN_BEAUTICIAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN_BEAUTICIAN.GENERIC"
