msgstr "Está abaixo do nível do mar."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.GREEN_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.GREEN_MUSHROOM.PICKED"
