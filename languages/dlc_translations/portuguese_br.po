msgstr "Elas são terrivelmente pegajosas."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_RUINS_DART_STATUE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_RUINS_DART_STATUE"
