msgstr "Um graveto."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROC_NEST_DEBRIS4
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROC_NEST_DEBRIS4"
