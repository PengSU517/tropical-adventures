msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CHECKERFLOOR"
msgid "Fancy floor."
msgstr "고급스러운 바닥이로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_COBBLEROAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_COBBLEROAD"
