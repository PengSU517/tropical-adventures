msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SWINGING_LIGHT_BASIC_BULB"
msgid "Sheesh. Someone doesn't care."
msgstr "저기 있잖아, 아무도 신경 안 써."

