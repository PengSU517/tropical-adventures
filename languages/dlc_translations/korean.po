msgstr "와! 근사하다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIG_RUINS_ARTICHOKE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIG_RUINS_ARTICHOKE"
