#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIG_RUINS_ENTRANCE5
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIG_RUINS_ENTRANCE5"
