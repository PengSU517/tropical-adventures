msgstr "숨으려고 한다."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RADISH_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RADISH_SEEDS"
