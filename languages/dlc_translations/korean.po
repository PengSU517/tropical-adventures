msgstr "이게 뭐라고?"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TRINKET_13
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TRINKET_13"
