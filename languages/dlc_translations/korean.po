msgstr "이제 무서운 벼락을 피할 수 있다!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_LOWRESEARCH"
