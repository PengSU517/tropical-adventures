msgstr "헤헤헤."

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.TELEPORTATO_RING
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.TELEPORTATO_RING"
