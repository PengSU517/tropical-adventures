msgstr "잘 자."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_FLORIST.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_FLORIST.GENERIC"
