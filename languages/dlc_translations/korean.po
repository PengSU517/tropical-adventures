msgstr "꽃이 아주 예쁜걸!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_FLORIST.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGMAN_FLORIST.SLEEPING"
