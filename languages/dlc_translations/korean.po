msgstr "박주가리"

#. STRINGS.MANDRAKEMANNAMES.13
msgctxt "STRINGS.MANDRAKEMANNAMES.13"
msgid "Quercus"
msgstr "참참이"

#. STRINGS.MANDRAKEMANNAMES.14
msgctxt "STRINGS.MANDRAKEMANNAMES.14"
