msgstr "모험이 시작된다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHIPWRECKED_EXIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHIPWRECKED_EXIT"
