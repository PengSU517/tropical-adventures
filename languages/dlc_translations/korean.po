msgstr "감미로워."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SWINGING_LIGHT_DERBY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SWINGING_LIGHT_DERBY"
