msgstr "이런!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGHOUSE_MINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGHOUSE_MINE.GENERIC"
