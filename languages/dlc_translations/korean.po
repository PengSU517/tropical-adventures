msgstr "해변 난로다."

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SEA_CHIMINEA.HIGH
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SEA_CHIMINEA.HIGH"
