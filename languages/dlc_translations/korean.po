msgstr "곧 자라겠지."

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SEAWEED_STALK
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SEAWEED_STALK"
