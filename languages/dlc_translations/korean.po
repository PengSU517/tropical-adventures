msgstr "아르르, 정말 이러기냐?"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DEERCLOPS_EYEBALL"
