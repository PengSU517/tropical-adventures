msgstr "하하! 우리가 왕이다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGEON.DEAD"
