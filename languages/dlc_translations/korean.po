msgstr "이야, 마법스럽다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAGMAROCK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAGMAROCK"
