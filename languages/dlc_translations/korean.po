#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MYSTERY_DOOR_NOT_FOUND
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MYSTERY_DOOR_NOT_FOUND"
