msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEA_CHIMINEA.OUT"
msgid "Fire's gone!"
msgstr "불이 사라졌다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEA_YARD.LOWFUEL
