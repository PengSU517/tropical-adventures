msgstr "네 보물로 인도해라!"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DRAGONFLYCHEST
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DRAGONFLYCHEST"
