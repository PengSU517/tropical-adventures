msgstr "다시 올라간다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIG_RUINS_EXIT4
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIG_RUINS_EXIT4"
