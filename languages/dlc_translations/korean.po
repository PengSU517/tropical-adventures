msgstr "구미에 맞아."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SWINGING_LIGHT_FLORAL_BULB
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SWINGING_LIGHT_FLORAL_BULB"
