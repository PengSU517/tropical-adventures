msgstr "으라차! 이야!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAGIC_SEAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAGIC_SEAL"
