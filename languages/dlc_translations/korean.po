msgstr "이제 아무짝에도 쓸모없어."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORKLAND_INTRO_FLAGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORKLAND_INTRO_FLAGS"
