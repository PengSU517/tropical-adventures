msgstr "내 머리에 쓰라고?"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.SLURTLEHOLE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.SLURTLEHOLE"
