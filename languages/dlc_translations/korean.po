msgstr "수상쩍어 보인다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIG_RUINS_ENTRANCE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIG_RUINS_ENTRANCE.GENERIC"
