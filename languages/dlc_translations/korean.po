msgstr "못 한다."

#. STRINGS.CHARACTERS.GENERIC.ACTIONFAIL.SADDLE.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.GENERIC.ACTIONFAIL.SADDLE.TARGETINCOMBAT"
