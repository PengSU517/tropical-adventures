msgstr "새 친구다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RO_BIN_GIZZARD_STONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RO_BIN_GIZZARD_STONE"
