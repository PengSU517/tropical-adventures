msgstr "못 써."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORKLAND_INTRO_BASKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORKLAND_INTRO_BASKET"
