msgstr "굉장하다!"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DRAGONFRUIT_COOKED"
