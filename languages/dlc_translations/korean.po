msgstr "출구다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIG_RUINS_EXIT2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIG_RUINS_EXIT2"
