msgstr "더는 없다."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DEPLETED_BUSH_VINE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DEPLETED_BUSH_VINE"
