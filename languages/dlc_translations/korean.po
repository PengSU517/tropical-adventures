msgstr "훌륭한 천이다."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DECO_WALLORNAMENT_EMBROIDERY_HOOP
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DECO_WALLORNAMENT_EMBROIDERY_HOOP"
