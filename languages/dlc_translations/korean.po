msgstr "싸울 필요는 없어!"

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.ROCK_ANTCAVE
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.ROCK_ANTCAVE"
