msgstr "船の帆もおしゃれにキメないと！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SNAKE_AMPHIBIOUS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SNAKE_AMPHIBIOUS"
