msgstr "かっけー！きっと誰かが交換してくれるよ。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_GIFTSHOP_3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_GIFTSHOP_3"
