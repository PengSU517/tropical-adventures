msgstr "わ、超どピンク！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.LOTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.LOTUS_FLOWER"
