msgstr "あれはすごく高い塔だね！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_GUARD_TOWER_PALACE.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_GUARD_TOWER_PALACE.BURNING"
