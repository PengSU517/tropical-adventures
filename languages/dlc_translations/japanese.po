msgstr "これで、いずこでも豆汁が飲めるぞ"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_ELEPHANTCACTUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_ELEPHANTCACTUS"
