msgstr "いぃったい！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ELEPHANTCACTUS_STUMP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ELEPHANTCACTUS_STUMP"
