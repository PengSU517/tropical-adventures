msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RO_BIN_GIZZARD_STONE"
msgid "Birds are disgusting."
msgstr "鳥は好きじゃねぇな。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RUBBLE"
