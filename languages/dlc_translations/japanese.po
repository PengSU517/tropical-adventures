msgid "Needs a good log."
msgstr "丸太をくべねぇとな"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SEA_YARD.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SEA_YARD.LOWFUEL"
