msgstr "うん、きっと貴重品だ。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_HAMLET_RING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_HAMLET_RING"
