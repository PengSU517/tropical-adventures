msgstr "砂の山だな"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAND_CASTLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAND_CASTLE.GENERIC"
