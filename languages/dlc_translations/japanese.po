#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MEAN_FLYTRAP.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MEAN_FLYTRAP.GENERIC"
