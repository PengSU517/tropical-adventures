msgstr "念のためにあいつは避けておこう。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_RUINS_SPEAR_TRAP
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_RUINS_SPEAR_TRAP"
