msgstr "救われた！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_SHOP_TINKER.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_SHOP_TINKER.BURNING"
