msgstr "静かにして起こさないようにしよう。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAMPIREBATCAVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAMPIREBATCAVE"
