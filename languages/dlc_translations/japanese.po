msgstr "燃料切れだぜ"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SEA_YARD.ON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SEA_YARD.ON"
