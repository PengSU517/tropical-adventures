msgstr "鈍くてとろい獣。"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HIPPO_ANTLER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HIPPO_ANTLER"
