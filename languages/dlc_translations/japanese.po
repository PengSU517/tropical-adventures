msgstr "悪くないんじゃない。"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INTERIOR_WALL_FLORAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INTERIOR_WALL_FLORAL"
