msgstr "あー！あっちに行って！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SNAKE_BONE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SNAKE_BONE"
