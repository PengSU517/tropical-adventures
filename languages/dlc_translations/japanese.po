msgstr "所持品が出てきちゃってる。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROOTTRUNK_CHILD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROOTTRUNK_CHILD"
