msgstr "十分だ。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYER_HOUSE_TURRET
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYER_HOUSE_TURRET"
