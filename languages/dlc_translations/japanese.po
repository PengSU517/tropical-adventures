msgstr "おまえなんか、友だちじゃないからな！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MANDRAKEHOUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MANDRAKEHOUSE"
