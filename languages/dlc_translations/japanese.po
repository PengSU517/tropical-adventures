msgstr "誰かオーブン点けっぱなしにした？"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYERHOUSE_CITY.FORSALE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYERHOUSE_CITY.FORSALE"
