msgstr "バーベキューだ。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_SHOP_WEAPONS.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_SHOP_WEAPONS.GENERIC"
