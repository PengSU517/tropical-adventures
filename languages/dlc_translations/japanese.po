msgstr "動かなくなっちゃった…"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.LOBSTER_DEAD_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.LOBSTER_DEAD_COOKED"
