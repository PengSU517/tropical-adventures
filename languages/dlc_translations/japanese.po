msgstr "こんな家があったら、キッチンにスタッフが必要だ。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYER_HOUSE_TUDOR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYER_HOUSE_TUDOR"
