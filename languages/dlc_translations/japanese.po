msgstr "キャンプの匂いがするヨ。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.GRASS_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.GRASS_TALL.GENERIC"
