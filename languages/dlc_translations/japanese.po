msgstr "汚ねェハチュウ類だゼ！"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.CROW.GENERIC"
