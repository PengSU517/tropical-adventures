msgstr "うわー、キレイだな。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.LOTUS_FLOWER_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.LOTUS_FLOWER_COOKED"
