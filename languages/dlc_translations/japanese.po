msgstr "育成する人。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_GENERAL.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_GENERAL.BURNING"
