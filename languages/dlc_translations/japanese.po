msgstr "きしむ。好きだ。"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INTERIOR_WALL_CHECKERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INTERIOR_WALL_CHECKERED"
