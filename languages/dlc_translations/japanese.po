msgstr "ワシの船に近づくんじゃねェぞ！"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MOOSEEGG"
