msgid "GET-ETH THEE GONE!"
msgstr "消えろ！"

#. STRINGS.CITY_PIG_TALK_RUN_FROM_SPIDER.pigman_shopkeep.3
msgctxt "STRINGS.CITY_PIG_TALK_RUN_FROM_SPIDER.pigman_shopkeep.3"
