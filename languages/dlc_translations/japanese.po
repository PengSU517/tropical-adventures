msgstr "ハチくんに「仕事しろ！」って、言いづらいよね～"

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.BEEBOX.SOMEHONEY"
