msgstr "キッチンを作らなくちゃ。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYER_HOUSE_GOTHIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYER_HOUSE_GOTHIC"
