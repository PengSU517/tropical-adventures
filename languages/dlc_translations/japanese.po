msgstr "本物のアナグマグマの胸毛でできてるよ～"

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.BEARGER_FUR"
