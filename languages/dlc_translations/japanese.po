msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAWNORNAMENT.BURNING"
msgid "Enkindled."
msgstr "燃えています。"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAWNORNAMENT.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAWNORNAMENT.BURNT"
