msgstr "ちっこい標石。"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MINISIGN.UNDRAWN"
