msgstr "家作りに使える素材。"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER_HOUSE_TURRET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER_HOUSE_TURRET"
