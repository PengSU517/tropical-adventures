msgstr "燃えてるゼ"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MARSH_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MARSH_TREE.BURNT"
