msgstr "どんどん燃えろ！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_CITYHALL_PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_SHOP_CITYHALL_PLAYER.GENERIC"
