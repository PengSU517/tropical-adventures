msgstr "気色悪りィ色だゼ…"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MOSQUITO_POISON
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MOSQUITO_POISON"
