msgstr "デュクシ！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAGIC_SEAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAGIC_SEAL"
msgid "Woah, magic-y!"
msgstr "うわー、魔法道具っぽーい！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAGMAROCK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAGMAROCK"
