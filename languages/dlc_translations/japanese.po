msgstr "友よ！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_MONKEY.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_MONKEY.DEAD"
