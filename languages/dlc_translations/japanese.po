msgstr "フランベ！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_SHOP_TINKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_SHOP_TINKER.GENERIC"
