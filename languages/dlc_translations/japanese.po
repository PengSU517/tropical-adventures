msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_SNAKESKINFLOOR"
msgid "My enemy's hide feels good beneath my feet!"
msgstr "敵の皮でこしらえた床だ！肌触りがよいな！"

