msgstr "ジロジロ見んなよなー"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TIGERSHARK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TIGERSHARK"
