msgstr "人魚姫の瞳みてェな色だゼ…"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MARSH_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MARSH_TREE.BURNING"
