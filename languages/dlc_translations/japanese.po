msgstr "ブンブンうっとうしィ音させやがって…"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MOSQUITO.HELD"
