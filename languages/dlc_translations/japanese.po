msgstr "最新のゲーム機だゼ！"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TRINKET_8
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TRINKET_8"
