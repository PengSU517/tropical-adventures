msgstr "やべぇぞ…！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHARKFINSOUP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHARKFINSOUP"
