msgstr "こんがり焼けてるゼ"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MERMHEAD.GENERIC"
