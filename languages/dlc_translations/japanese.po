msgstr "炭火焼きにしたシャポーね。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_SHOP_HATSHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_SHOP_HATSHOP.GENERIC"
