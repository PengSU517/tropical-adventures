msgstr "船もオシャレしねぇとな"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SNAKE_AMPHIBIOUS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SNAKE_AMPHIBIOUS"
