msgstr "獣の肉だゼ"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MEATBALLS"
