msgstr "我が壁に相応しき飾り。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECO_WALLORNAMENT_MOSAIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECO_WALLORNAMENT_MOSAIC"
