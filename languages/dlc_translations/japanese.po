msgstr "なんでこれは植えられてないんだ？"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEDGE_LAYERED_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEDGE_LAYERED_ITEM"
