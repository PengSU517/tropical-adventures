#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINDOW_SMALL_PEAKED_CURTAIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINDOW_SMALL_PEAKED_CURTAIN"
