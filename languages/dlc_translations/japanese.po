msgstr "残念だな"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEDGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEDGE.GENERIC"
