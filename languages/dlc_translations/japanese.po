msgstr "ちょっと退屈。"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INTERIOR_WALL_ROPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INTERIOR_WALL_ROPE"
