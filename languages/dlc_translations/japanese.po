msgstr "イカしたモンスターだ！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAMPIREBAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAMPIREBAT.SLEEPING"
