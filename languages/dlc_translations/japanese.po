msgstr "人魚姫の瞳みてェな色だゼ…"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MARSH_PLANT_TROPICAL
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MARSH_PLANT_TROPICAL"
