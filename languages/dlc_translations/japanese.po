msgstr "ロープの知識はある。"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HARDSHELL_TACOS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HARDSHELL_TACOS"
