msgstr "すっかりくたばっちまってるな"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.JELLYFISH_PLANTED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.JELLYFISH_PLANTED"
