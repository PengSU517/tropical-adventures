msgstr "早寝早起き..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PIGMAN_FLORIST.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PIGMAN_FLORIST.GENERIC"
