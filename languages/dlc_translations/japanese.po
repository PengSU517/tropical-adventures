msgstr "デコボコしてるー"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_LIMESTONE_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_LIMESTONE_ITEM"
