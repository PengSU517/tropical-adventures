msgstr "お洒落。"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INTERIOR_WALL_MAYORSOFFICE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INTERIOR_WALL_MAYORSOFFICE"
