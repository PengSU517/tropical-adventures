msgstr "暗い海も照らせるゼ"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MINISIGN.GENERIC"
