msgstr "あの嫌なモンスターの住処だな。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAMPIRE_BAT_WING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAMPIRE_BAT_WING"
