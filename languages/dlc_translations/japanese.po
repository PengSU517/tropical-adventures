msgstr "昼寝が終わるまで待たなくちゃ。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PIGMAN_ERUDITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PIGMAN_ERUDITE.GENERIC"
