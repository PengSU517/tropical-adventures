msgstr "岩だ。なんて味気ない。"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALAGMITE_LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALAGMITE_LOW"
