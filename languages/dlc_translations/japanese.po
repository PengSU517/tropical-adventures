#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MOSQUITOSACK_YELLOW
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MOSQUITOSACK_YELLOW"
