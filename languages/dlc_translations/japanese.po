msgstr "沈んじゃうよ！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAWLNETDROPPED.SOONISH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAWLNETDROPPED.SOONISH"
