msgstr "的確な結末だ。"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIG_SHOP_CITYHALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIG_SHOP_CITYHALL.GENERIC"
