msgstr "分厚くて毛深そう。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUSTY_SHOOTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUSTY_SHOOTER"
