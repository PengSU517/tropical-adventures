msgstr "うわー！こっちに来るな！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SNAKE_POISON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SNAKE_POISON"
