msgstr "なんだか…矛盾した味がしそうだヨ…"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PLANT_NORMAL.GENERIC"
