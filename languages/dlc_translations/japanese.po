msgstr "クソだらけだ。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUNGPILE.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUNGPILE.PICKED"
