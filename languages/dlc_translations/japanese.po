msgstr "いてて！ケバブになるところだった！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_RUINS_TORCH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_RUINS_TORCH"
