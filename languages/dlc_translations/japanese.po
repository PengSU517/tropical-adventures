msgstr "あいつにかまれると、ちとやっかいだぜ"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SNAPDRAGON.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SNAPDRAGON.DEAD"
