#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MULTITOOL_AXE_PICKAXE"
