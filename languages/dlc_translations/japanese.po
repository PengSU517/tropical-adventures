msgstr "不気味な鳥。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.THUNDERBIRDNEST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.THUNDERBIRDNEST"
