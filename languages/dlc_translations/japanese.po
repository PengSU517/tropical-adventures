msgstr "悪くないんじゃない。"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INTERIOR_WALL_HARLEQUIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INTERIOR_WALL_HARLEQUIN"
