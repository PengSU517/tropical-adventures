msgstr "あのチビ、いい海賊になりそうだゼ"

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.LIVINGJUNGLETREE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.LIVINGJUNGLETREE"
