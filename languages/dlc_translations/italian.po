msgstr "Forse posso farlo schiudere?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
