msgstr "Mi chiedo come sia la cucina."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_RUINS_ARTICHOKE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_RUINS_ARTICHOKE"
