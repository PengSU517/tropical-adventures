msgstr "Funziona perfettamente!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEMAKER.LOW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEMAKER.LOW"
