msgstr "Potrei costruirci un castello decente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOUBLE_UMBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOUBLE_UMBRELLAHAT"
