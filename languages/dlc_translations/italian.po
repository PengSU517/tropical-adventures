msgstr "Dovrei piantarlo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUG_NETTLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUG_NETTLE"
