msgstr "Wow! Che finestra enorme!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WINDOW_LARGE_SQUARE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WINDOW_LARGE_SQUARE"
