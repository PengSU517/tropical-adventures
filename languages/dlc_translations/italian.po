msgstr "Semplicemente squisito."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGON_SCALES"
