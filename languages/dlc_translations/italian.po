msgstr "Non devi essere più triste..."

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.WHALE_CARCASS_WHITE
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.WHALE_CARCASS_WHITE"
