msgstr "Ah, sì, una specie di ristorante."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_SHOP_FLORIST.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_SHOP_FLORIST.BURNING"
