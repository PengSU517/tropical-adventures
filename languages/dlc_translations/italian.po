msgstr "Non ho un buon presentimento."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_RUINS_DART_TRAP
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_RUINS_DART_TRAP"
