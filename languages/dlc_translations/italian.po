msgstr "Mi sento già più sicuro."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_MONKEY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_MONKEY.GENERIC"
