msgstr "Possiamo cibarcene?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_SW_BOX
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_SW_BOX"
