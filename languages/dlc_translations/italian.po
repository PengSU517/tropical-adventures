msgstr "Una porta. Dovrei attraversarla."

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.WORM.DIRT"
