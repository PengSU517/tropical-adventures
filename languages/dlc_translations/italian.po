msgstr "Gnammi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TEATREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TEATREE_SAPLING"
