msgstr "Mi chiedo dove sia andato..."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_WHALE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_WHALE_HUNT_LOST_TRAIL_SPRING"
