msgstr "Una pratica tabella per i miei esperimenti alchemici."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECO_WALLORNAMENT_PHOTO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECO_WALLORNAMENT_PHOTO"
