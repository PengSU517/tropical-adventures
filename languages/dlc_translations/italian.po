msgstr "Uno scheletro umano incredibilmente ben conservato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SKELETON_PLAYER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SKELETON_PLAYER"
