msgstr "Morto sterchito."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUNGBEETLE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUNGBEETLE.GENERIC"
