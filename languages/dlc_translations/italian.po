msgstr "Per riporre il mio bottino."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.SHELVES_WALLMOUNT
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.SHELVES_WALLMOUNT"
