msgstr "Tecnologia bellica antica."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SPEARGUN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SPEARGUN"
