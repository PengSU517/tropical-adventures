msgstr "La scienza dice che fanno bene."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASPARAGUS_PLANTED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASPARAGUS_PLANTED"
