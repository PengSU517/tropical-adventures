msgstr "Farei meglio a coltivarli!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISH_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISH_FARM.EMPTY"
