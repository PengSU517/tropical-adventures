msgstr "È indubbiamente cacca."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUNGBEETLE.DEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUNGBEETLE.DEAD"
