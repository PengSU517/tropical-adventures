msgstr "Starebbe bene in un cappello da indossare la domenica a messa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOYDOYNEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOYDOYNEST"
