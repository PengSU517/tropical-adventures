msgstr "Mmm! Sa di cibo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPICALFAN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPICALFAN"
