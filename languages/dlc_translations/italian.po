msgstr "Un peccato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISH_MED_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISH_MED_COOKED"
