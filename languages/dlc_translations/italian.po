msgstr "Qualcuno ha un vite allentata."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_SW_CRANK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_SW_CRANK"
