msgstr "Fa entrare la luce."

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.WINDOW_ROUND
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.WINDOW_ROUND"
