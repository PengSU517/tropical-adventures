msgstr "È stranamente leggero."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORSEASHELL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORSEASHELL"
