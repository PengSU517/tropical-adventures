msgstr "Dovrebbe tenerci al sicuro."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TORNADO
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TORNADO"
