msgstr "Pareti infuse di limone!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WALL_PIG_RUINS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WALL_PIG_RUINS"
