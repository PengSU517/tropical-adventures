msgstr "La perfetta maturazione."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TUBER_BLOOM_CROP_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TUBER_BLOOM_CROP_COOKED"
