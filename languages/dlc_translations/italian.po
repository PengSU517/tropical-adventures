msgstr "L'hanno cotta al flambé!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_GUARD_TOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_GUARD_TOWER.GENERIC"
