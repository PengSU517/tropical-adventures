msgstr "Entità metafisica."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENT_HULK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENT_HULK"
