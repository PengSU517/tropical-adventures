msgstr "Splendidamente grigliato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISH_RAW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISH_RAW"
