msgstr "Passaggio acquatico!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_WHALE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_WHALE_HUNT_BEAST_NEARBY"
