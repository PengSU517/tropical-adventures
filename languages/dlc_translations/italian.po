msgstr "Ti abbatterò, creatura maledetta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAMPIREBAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAMPIREBAT.SLEEPING"
