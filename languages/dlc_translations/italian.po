msgstr "Una cosa per aprire altre cose."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WOOD_DOOR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WOOD_DOOR"
