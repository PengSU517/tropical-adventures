msgstr "I gambi cresceranno col tempo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUSH_VINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUSH_VINE.GENERIC"
