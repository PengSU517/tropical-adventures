msgstr "Ti nascondi sotto il vento, cattivo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWISTER_SEAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWISTER_SEAL"
