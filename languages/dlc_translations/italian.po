msgstr "È strano!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_SW_POTATO
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_SW_POTATO"
