msgstr "Una bella finestra resistente."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WINDOW_ROUND_BURLAP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WINDOW_ROUND_BURLAP"
