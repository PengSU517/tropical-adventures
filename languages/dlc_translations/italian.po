msgstr "Uhmm. Non sono sicuro."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ELEPHANTCACTUS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ELEPHANTCACTUS"
