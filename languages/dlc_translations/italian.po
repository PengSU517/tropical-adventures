msgstr "Credo che ci siano più parti."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_SW_BASE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_SW_BASE"
