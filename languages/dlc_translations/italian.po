msgstr "Ti sembro un giardiniere?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BUSH_VINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BUSH_VINE"
