msgstr "Un vero Lusus naturae!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SNAPDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SNAPDRAGON.SLEEPING"
