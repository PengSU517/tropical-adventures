msgstr "Beh, ora è maturo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TUBER_BLOOM_CROP_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TUBER_BLOOM_CROP_COOKED"
