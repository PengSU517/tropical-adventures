msgstr "Grazioso..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECO_WALLORNAMENT_PERIODIC_TABLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECO_WALLORNAMENT_PERIODIC_TABLE"
