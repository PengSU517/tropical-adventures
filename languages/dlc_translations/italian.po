msgstr "Beh, ha funzionato."

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.DIVININGRODSTART"
