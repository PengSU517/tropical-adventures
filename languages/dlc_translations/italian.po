msgstr "Non sono una schizzinosa io."

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.WINDOW_ROUND_BURLAP
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.WINDOW_ROUND_BURLAP"
