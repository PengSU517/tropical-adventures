msgstr "Un piccolo seme all'interno."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BURR_SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BURR_SAPLING.BURNING"
