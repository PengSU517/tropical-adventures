msgstr "Non c'è molto da vedere."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUNKEN_BOAT_BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUNKEN_BOAT_BURNT"
