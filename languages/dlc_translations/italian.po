msgstr "Non sapranno cosa li ha colpiti."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BLOWDART_POISON
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BLOWDART_POISON"
