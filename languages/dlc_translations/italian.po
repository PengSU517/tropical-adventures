msgstr "Ehi amico."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SUNKEN_BOAT_BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SUNKEN_BOAT_BURNT"
