msgstr "Fritta!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_GUARD_TOWER_PALACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PIG_GUARD_TOWER_PALACE.GENERIC"
