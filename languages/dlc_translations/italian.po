msgstr "Un po' squadrata per i miei gusti."

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.WINDOW_LARGE_SQUARE_CURTAIN
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.WINDOW_LARGE_SQUARE_CURTAIN"
