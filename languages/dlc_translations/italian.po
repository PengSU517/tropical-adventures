msgstr "Splendidamente grigliato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISH_FARM.BLUEFISH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISH_FARM.BLUEFISH"
