msgstr "Hamburger da far venire l'acquolina in bocca."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STEELWOOL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STEELWOOL"
