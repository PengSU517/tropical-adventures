msgstr "C'è qualcosa laggiù..."

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.WHALE_CARCASS_BLUE
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.WHALE_CARCASS_BLUE"
