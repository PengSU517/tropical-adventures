#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.INTERIOR_FLOOR_OCTAGON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.INTERIOR_FLOOR_OCTAGON"
