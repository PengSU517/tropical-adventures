msgstr "原材料。"

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SWINGING_LIGHT_BASIC_METAL
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SWINGING_LIGHT_BASIC_METAL"
