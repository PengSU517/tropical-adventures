msgstr "真好看。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.INTERIOR_WALL_UPHOLSTERED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.INTERIOR_WALL_UPHOLSTERED"
