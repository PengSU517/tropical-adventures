msgstr "不如用拳头爽，但还是很好！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OBSIDIAN_WORKBENCH
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OBSIDIAN_WORKBENCH"
