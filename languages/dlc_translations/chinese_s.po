msgstr "糟了！"

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.EVERGREEN_SPARSE.BURNT"
