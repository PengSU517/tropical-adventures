#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.INTERIOR_WALL_FULLWALL_MOULDING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.INTERIOR_WALL_FULLWALL_MOULDING"
