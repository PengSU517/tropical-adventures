msgstr "黄色吊袋。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITO_POISON
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITO_POISON"
