msgstr "黑暗来临了！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OBSIDIANFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OBSIDIANFIREPIT.GENERIC"
