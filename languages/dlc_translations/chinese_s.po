msgstr "嗨，小树伙计。"

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.COCONUT_COOKED
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.COCONUT_COOKED"
