msgstr "它已被夷平。"

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
