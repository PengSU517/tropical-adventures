msgstr "让花园丰富多彩的村民。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGMAN_FLORIST.SLEEPING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGMAN_FLORIST.SLEEPING"
