#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.INTERIOR_WALL_HARLEQUIN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.INTERIOR_WALL_HARLEQUIN"
