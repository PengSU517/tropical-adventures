msgstr "叔叔可没这样的胆。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITOSACK_YELLOW
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITOSACK_YELLOW"
