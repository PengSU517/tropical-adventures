msgstr "我众多珍宝的其中一个。"

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.DECO_CAVE_BAT_BURROW
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.DECO_CAVE_BAT_BURROW"
