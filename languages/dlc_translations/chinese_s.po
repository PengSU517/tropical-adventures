msgstr "不是优质食品里最优质的。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TEATREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TEATREE_SAPLING"
