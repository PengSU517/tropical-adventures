msgstr "坏蛋！"

#. STRINGS.MANDRAKEMAN_MANDRAKE_BATTLECRY.4
msgctxt "STRINGS.MANDRAKEMAN_MANDRAKE_BATTLECRY.4"
msgid "CHEAT!"
msgstr "骗子！"

