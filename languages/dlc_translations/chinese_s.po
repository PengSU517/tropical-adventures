msgstr "蘑菇灌木。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_SMALL.BLOOM"
