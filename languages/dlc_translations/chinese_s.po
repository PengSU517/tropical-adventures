msgstr "一个文明的产物！"

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SUNKEN_BOAT_TRINKET_2
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SUNKEN_BOAT_TRINKET_2"
