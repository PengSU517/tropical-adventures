msgstr "灯灭了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CLAWPALMTREE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CLAWPALMTREE"
