msgstr "无聊。"

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SWINGING_LIGHT_CHANDALIER_CANDLES
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SWINGING_LIGHT_CHANDALIER_CANDLES"
