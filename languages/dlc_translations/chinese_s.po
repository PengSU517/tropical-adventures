msgstr "它被打败了！"

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SPIDER_WARRIOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SPIDER_WARRIOR.GENERIC"
