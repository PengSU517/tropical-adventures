msgstr "你在看什么？"

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.DECO_ANTIQUITIES_WALLFISH
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.DECO_ANTIQUITIES_WALLFISH"
