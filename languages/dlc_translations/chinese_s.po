msgstr "它通往某个地方，这正是我害怕的。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TELEPORTATO_HAMLET_BOX
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TELEPORTATO_HAMLET_BOX"
