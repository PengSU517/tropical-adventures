msgstr "我说，有人想家了！"

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.ROC_NEST_RUSTY_LAMP
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.ROC_NEST_RUSTY_LAMP"
