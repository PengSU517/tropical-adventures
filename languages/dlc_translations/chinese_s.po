msgstr "火桌子。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCTOPUSCHEST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCTOPUSCHEST"
