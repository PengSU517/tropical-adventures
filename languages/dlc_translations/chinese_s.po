msgstr "一盏吊灯。"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SWINGING_LIGHT_PENDANT_CHERRIES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SWINGING_LIGHT_PENDANT_CHERRIES"
