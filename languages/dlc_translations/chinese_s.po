#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SWINGING_LIGHT_BASIC_BULB
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SWINGING_LIGHT_BASIC_BULB"
