msgstr "常用于建筑中。"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIMPETROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIMPETROCK.GENERIC"
