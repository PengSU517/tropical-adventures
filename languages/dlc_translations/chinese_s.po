#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.INTERIOR_WALL_CIRCLES
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.INTERIOR_WALL_CIRCLES"
