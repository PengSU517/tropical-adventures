msgstr "一盏灯。"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SWINGING_LIGHT_ROPE_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SWINGING_LIGHT_ROPE_1"
