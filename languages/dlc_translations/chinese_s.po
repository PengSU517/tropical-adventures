msgstr "棒。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.INTERIOR_WALL_FULLWALL_MOULDING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.INTERIOR_WALL_FULLWALL_MOULDING"
