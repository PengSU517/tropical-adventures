msgstr "我怀疑里面有生物。"

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SPIDER_MONKEY_TREE
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SPIDER_MONKEY_TREE"
