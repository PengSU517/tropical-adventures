msgstr "很难保存。"

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.SLURTLE_SHELLPIECES
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.SLURTLE_SHELLPIECES"
