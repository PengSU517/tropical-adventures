msgstr "在这种状态下毫无价值"

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SUNKEN_BOAT_TRINKET_1
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SUNKEN_BOAT_TRINKET_1"
