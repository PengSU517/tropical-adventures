msgstr "樱桃小点！"

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SWINGING_LIGHT_ROPE_1
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SWINGING_LIGHT_ROPE_1"
