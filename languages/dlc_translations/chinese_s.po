msgstr "船不该这么用！"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUNKEN_BOAT.ABANDONED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUNKEN_BOAT.ABANDONED"
