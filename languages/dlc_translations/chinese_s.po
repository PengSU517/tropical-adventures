msgstr "没用的警卫。"

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SPOILED_FISH
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.SPOILED_FISH"
