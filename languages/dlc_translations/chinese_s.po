msgstr "请别逮捕我。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGMAN_ROYALGUARD.SLEEPING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGMAN_ROYALGUARD.SLEEPING"
