msgstr "第二层伞使第一层伞保持干燥。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DOYDOY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DOYDOY"
