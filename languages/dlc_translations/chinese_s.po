msgstr "不寻常的工件。"

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.ROC_NEST_TREE1
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.ROC_NEST_TREE1"
