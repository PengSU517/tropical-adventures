msgstr "海藻。"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEAWEED_STALK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEAWEED_STALK"
