msgstr "她看起来很专横。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGMAN_ROYALGUARD.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGMAN_ROYALGUARD.GENERIC"
