msgstr "绳结很酷！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.INTERIOR_WALL_SUNFLOWER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.INTERIOR_WALL_SUNFLOWER"
