#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.INTERIOR_FLOOR_MARBLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.INTERIOR_FLOOR_MARBLE"
