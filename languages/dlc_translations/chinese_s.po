msgstr "我想是某个大鸟的人工制品。"

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.ROC_NEST_TRUNK
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.ROC_NEST_TRUNK"
