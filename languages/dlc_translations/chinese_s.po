msgstr "最强的斧子！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OBSIDIANCOCONADE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OBSIDIANCOCONADE"
