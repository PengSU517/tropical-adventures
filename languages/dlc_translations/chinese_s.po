#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.INTERIOR_WALL_CHECKERED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.INTERIOR_WALL_CHECKERED"
