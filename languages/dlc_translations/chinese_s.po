msgstr "难道她不会更喜欢一张花床吗？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGMAN_HATMAKER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGMAN_HATMAKER.GENERIC"
