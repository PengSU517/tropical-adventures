msgstr "啊...羽毛上的眼睛都没了。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.INTERIOR_WALL_PLAIN_DS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.INTERIOR_WALL_PLAIN_DS"
