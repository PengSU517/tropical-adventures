msgstr "一个我从没见过的腹足类动物。"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLUGBUG_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLUGBUG_COOKED"
