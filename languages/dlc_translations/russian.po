msgstr "Я люблю морских млекопитающих!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WHALE_BUBBLES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WHALE_BUBBLES"
