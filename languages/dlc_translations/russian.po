msgstr "Вот тебе, природа!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SNAKEDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SNAKEDEN.GENERIC"
