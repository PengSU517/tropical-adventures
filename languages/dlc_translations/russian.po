msgstr "Выглядит древним."

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.ROC_NEST_HOUSE
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.ROC_NEST_HOUSE"
