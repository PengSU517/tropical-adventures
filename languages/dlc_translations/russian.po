msgstr "Обычное пламя. Никакой науки."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CITY_LAMP.ON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CITY_LAMP.ON"
