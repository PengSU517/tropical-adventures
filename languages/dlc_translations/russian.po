msgstr "Отличное лазательное дерево."

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.ROC_NEST_TRUNK
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.ROC_NEST_TRUNK"
