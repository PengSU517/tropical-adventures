msgstr "О, палочка!"

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.ROC_NEST_DEBRIS2
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.ROC_NEST_DEBRIS2"
