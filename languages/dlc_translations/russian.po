msgstr "Мы можем приглашать друзей!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.DECO_CHAIR_MASSAGER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.DECO_CHAIR_MASSAGER"
