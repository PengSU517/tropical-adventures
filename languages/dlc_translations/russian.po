msgstr "Стой смирно!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENCRUSTEDBOAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENCRUSTEDBOAT"
