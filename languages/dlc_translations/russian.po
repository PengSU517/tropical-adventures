msgstr "Не особо интересная палка."

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.ROC_NEST_DEBRIS3
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.ROC_NEST_DEBRIS3"
