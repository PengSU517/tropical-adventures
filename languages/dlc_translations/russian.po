msgstr "Ха, вот это куча!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUNGPILE.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUNGPILE.PICKED"
