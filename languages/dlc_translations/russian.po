msgstr "Весьма расточительно!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SWEET_POTATO
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SWEET_POTATO"
