msgstr "Это надо посадить где-нибудь в океане."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEA_CHIMINEA.EMBERS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEA_CHIMINEA.EMBERS"
