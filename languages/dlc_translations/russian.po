msgstr "Оставь меня в покое!"

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.SNAKE_BONE
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.SNAKE_BONE"
