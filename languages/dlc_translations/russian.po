msgstr "Здесь мы будем сидеть!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.DECO_CHAIR_LOUNGE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.DECO_CHAIR_LOUNGE"
