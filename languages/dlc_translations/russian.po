msgstr "Семена. Сладкие."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SWIMMINGHORROR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SWIMMINGHORROR"
