msgstr "У Вудлегса от нево голова болит."

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.INSANITYROCK.INACTIVE"
