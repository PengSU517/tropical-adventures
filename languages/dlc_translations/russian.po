msgstr "Эх. Там очень глубоко, да?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SUPERTELESCOPE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SUPERTELESCOPE"
