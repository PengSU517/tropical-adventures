msgstr "Здесь мы будем сидеть!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.DECO_CHAIR_FOOTREST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.DECO_CHAIR_FOOTREST"
