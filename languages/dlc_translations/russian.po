msgstr "Здесь мы будем сидеть!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.DECO_CHAIR_CORNER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.DECO_CHAIR_CORNER"
