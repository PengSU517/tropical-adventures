msgstr "Окно наружу."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINDOW_TALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINDOW_TALL"
