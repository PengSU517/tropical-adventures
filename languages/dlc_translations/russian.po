msgstr "Полагаю, это палка."

#. STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.ROC_NEST_DEBRIS4
msgctxt "STRINGS.CHARACTERS.WARBUCKS.DESCRIBE.ROC_NEST_DEBRIS4"
