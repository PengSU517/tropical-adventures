msgstr "Это устройство использует силу повозки Одина!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.IRON_DOOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.IRON_DOOR"
