msgstr "Это, конечно, не шотландка, но мне сойдет."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SWEETPOTATOSOUFFLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SWEETPOTATOSOUFFLE"
