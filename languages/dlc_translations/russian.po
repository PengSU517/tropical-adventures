msgstr "Мы можем приглашать друзей!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.DECO_CHAIR_CLASSIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.DECO_CHAIR_CLASSIC"
