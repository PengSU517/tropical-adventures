msgstr "Нечего тут тереться об меня!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ELEPHANTCACTUS_ACTIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ELEPHANTCACTUS_ACTIVE"
