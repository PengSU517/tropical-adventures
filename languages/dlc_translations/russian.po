msgstr "Сломан до основания."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VOLCANO_ALTAR_TOWER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VOLCANO_ALTAR_TOWER"
