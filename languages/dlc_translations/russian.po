msgstr "Тут уже ничего не поделаешь."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SNAPDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SNAPDRAGON.GENERIC"
